@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager Navigation

<nav class="pillar-nav" aria-label="Main navigation">
    <div class="nav-brand">
        <NavLink href="/"
                 Match="NavLinkMatch.All"
                 class="brand-link"
                 aria-label="Smart-X dashboard">
            <span class="brand-mark">S</span>
            <span class="brand-copy">
                <strong>SMART-X</strong>
                <small>IoT MESH ECOSYSTEM</small>
            </span>
        </NavLink>
    </div>

    <div class="nav-links">
        <NavLink href="/"
                 Match="NavLinkMatch.All"
                 class="nav-link">
            <span class="nav-icon" aria-hidden="true">⌂</span>
            <span>Overview</span>
        </NavLink>

        <section class="@CommandPillarClass"
                 aria-label="Command Management">
            <div class="pillar-heading">
                <span class="nav-icon" aria-hidden="true">⌘</span>
                <span>Command Management</span>

                @if (IsCommandPillarActive)
                {
                    <span class="pillar-indicator"
                          aria-label="Active section"></span>
                }
            </div>

            <div class="pillar-links">
                <NavLink href="/commands"
                         Match="NavLinkMatch.All"
                         class="nav-link nav-child">
                    <span>Command Stream</span>
                    <span class="nav-pill">PART 2</span>
                </NavLink>

                <NavLink href="/command-history"
                         Match="NavLinkMatch.All"
                         class="nav-link nav-child">
                    <span>Command History</span>
                </NavLink>

                <NavLink href="/collection-diagnostics"
                         Match="NavLinkMatch.All"
                         class="nav-link nav-child">
                    <span>Collection Diagnostics</span>
                </NavLink>
            </div>
        </section>
    </div>

    <div class="nav-footer">
        <span class="connection-dot" aria-hidden="true"></span>
        <span>Application online</span>
    </div>
</nav>

@code {
    private bool IsCommandPillarActive =>
        GetCurrentPath() is
            "commands" or
            "command-history" or
            "collection-diagnostics";

    private string CommandPillarClass =>
        IsCommandPillarActive
            ? "nav-pillar pillar-active"
            : "nav-pillar";

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private string GetCurrentPath()
    {
        var relativePath =
            Navigation.ToBaseRelativePath(Navigation.Uri);

        var path = relativePath
            .Split('?', '#')[0]
            .Trim('/');

        return path.ToLowerInvariant();
    }

    private void HandleLocationChanged(
        object? sender,
        LocationChangedEventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}