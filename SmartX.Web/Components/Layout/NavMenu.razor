@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager Navigation

<nav class="pillar-nav" aria-label="Main navigation">
    <div class="nav-brand">
        <NavLink href="/"
                 Match="NavLinkMatch.All"
                 class="brand-link"
                 aria-label="Smart-X dashboard">
            <span class="brand-mark" aria-hidden="true">S</span>

            <span class="brand-copy">
                <strong>SMART-X</strong>
                <small>IoT Gateway Ecosystem</small>
            </span>
        </NavLink>
    </div>

    <div class="nav-section">
        <h2 class="nav-section-title">MAIN MENU</h2>

        <div class="pillar-links">
            <NavLink href="/"
                     Match="NavLinkMatch.All"
                     class="nav-link">
                <span class="nav-icon" aria-hidden="true">⌂</span>
                <span class="nav-link-label">Overview</span>
            </NavLink>
        </div>
    </div>

    <section class="@CommandPillarClass"
             aria-label="Command Management">
        <h2 class="nav-section-title">COMMAND MANAGEMENT</h2>

        <div class="pillar-links">
            <NavLink href="/commands"
                     Match="NavLinkMatch.All"
                     class="nav-link">
                <span class="nav-icon" aria-hidden="true">↗</span>
                <span class="nav-link-label">Command Stream</span>
            </NavLink>

            <NavLink href="/command-history"
                     Match="NavLinkMatch.All"
                     class="nav-link">
                <span class="nav-icon" aria-hidden="true">◷</span>
                <span class="nav-link-label">Command History</span>
            </NavLink>

            <NavLink href="/collection-diagnostics"
                     Match="NavLinkMatch.All"
                     class="nav-link">
                <span class="nav-icon" aria-hidden="true">⊞</span>
                <span class="nav-link-label">Collection Diagnostics</span>
            </NavLink>
        </div>
    </section>

    <div class="nav-spacer"></div>

    <div class="nav-footer">
        <span class="connection-dot" aria-hidden="true"></span>

        <span class="nav-footer-copy">
            <strong>Application status</strong>
            <small>Online</small>
        </span>
    </div>
</nav>

@code {
    private bool IsCommandPillarActive =>
        GetCurrentPath() is
            "commands" or
            "command-history" or
            "collection-diagnostics";

    private string CommandPillarClass =>
        IsCommandPillarActive
            ? "nav-pillar pillar-active"
            : "nav-pillar";

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private string GetCurrentPath()
    {
        var relativePath = Navigation.ToBaseRelativePath(
            Navigation.Uri);

        return relativePath
            .Split('?', '#')[0]
            .Trim('/')
            .ToLowerInvariant();
    }

    private void HandleLocationChanged(
        object? sender,
        LocationChangedEventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
