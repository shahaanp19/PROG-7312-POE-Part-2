@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-topbar">
        <a class="brand" href="/" aria-label="Smart-X dashboard">
            <span class="brand-mark">S</span>
            <span class="brand-copy">
                <span class="brand-name">SMART-X</span>
                <span class="brand-subtitle">IoT Gateway Ecosystem</span>
            </span>
        </a>

        <div class="gateway-status" aria-label="Gateway interface status">
            <span class="status-dot" aria-hidden="true"></span>
            <span>Gateway Interface</span>
            <span class="gateway-status-divider" aria-hidden="true"></span>
            <span class="gateway-status-label">MODULAR OPERATIONS</span>
        </div>
    </header>

    <NavMenu />

    <main class="app-main" id="main-content" tabindex="-1">
        @Body
    </main>

    <footer class="app-footer">
        <div class="footer-brand">
            <span class="footer-mark">S</span>
            <span>SMART-X <span class="footer-separator">/</span> IoT GATEWAY</span>
        </div>

        <div class="footer-meta">
            <span>Telemetry</span>
            <span class="footer-bullet" aria-hidden="true"></span>
            <span>Command Operations</span>
            <span class="footer-bullet" aria-hidden="true"></span>
            <span>Mesh Ecosystem</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <div class="error-ui-content">
        <span class="error-ui-icon" aria-hidden="true">!</span>
        <span>
            <strong>Connection interrupted</strong>
            <small>An unexpected application error occurred.</small>
        </span>
    </div>

    <div class="error-ui-actions">
        <a href="" class="reload">Reload application</a>
        <button type="button"
                class="dismiss"
                aria-label="Dismiss error notification"
                onclick="document.getElementById('blazor-error-ui').style.display='none'">
            ×
        </button>
    </div>
</div>

<style>
    :root {
        --sx-navy: #101a2e;
        --sx-blue: #3978ed;
        --sx-blue-strong: #245fd1;
        --sx-text: #19243a;
        --sx-muted: #718096;
        --sx-border: #e2e8f0;
        --sx-surface: #ffffff;
        --sx-background: #f4f7fb;
        --sx-green: #20a875;
    }

    .app-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        color: var(--sx-text);
        background: var(--sx-background);
        font-family: Inter, "Segoe UI", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    .app-topbar {
        position: relative;
        z-index: 2;
        min-height: 78px;
        padding: 0 34px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        color: #fff;
        background: var(--sx-navy);
        border-bottom: 3px solid var(--sx-blue);
    }

    .brand {
        min-width: 0;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: inherit;
        text-decoration: none;
        border-radius: 8px;
    }

        .brand:focus-visible {
            outline: 2px solid #9bbcff;
            outline-offset: 5px;
        }

    .brand-mark {
        width: 43px;
        height: 43px;
        flex: 0 0 43px;
        display: grid;
        place-items: center;
        border: 1px solid rgb(255 255 255 / 16%);
        border-radius: 12px;
        color: #fff;
        background: linear-gradient(145deg, #4988ff, #2862d5);
        box-shadow: 0 4px 14px rgb(0 0 0 / 15%);
        font-size: 23px;
        font-weight: 850;
    }

    .brand-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .brand-name {
        font-size: 17px;
        font-weight: 850;
        letter-spacing: 2px;
    }

    .brand-subtitle {
        color: #aab8ce;
        font-size: 11px;
        letter-spacing: .25px;
    }

    .gateway-status {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #dbe4f1;
        font-size: 12px;
        font-weight: 600;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        flex: 0 0 8px;
        border-radius: 50%;
        background: var(--sx-green);
        box-shadow: 0 0 0 4px rgb(32 168 117 / 13%);
    }

    .gateway-status-divider {
        width: 1px;
        height: 18px;
        margin: 0 2px;
        background: rgb(255 255 255 / 20%);
    }

    .gateway-status-label {
        color: #9eafc8;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .app-main {
        width: 100%;
        flex: 1 0 auto;
        padding: 30px 34px;
        outline: none;
    }

    .app-footer {
        min-height: 57px;
        padding: 16px 34px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        color: var(--sx-muted);
        background: var(--sx-surface);
        border-top: 1px solid var(--sx-border);
        font-size: 10px;
    }

    .footer-brand,
    .footer-meta {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .footer-brand {
        color: #47566d;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: .65px;
    }

    .footer-mark {
        width: 20px;
        height: 20px;
        display: grid;
        place-items: center;
        border-radius: 5px;
        color: #fff;
        background: var(--sx-navy);
        font-size: 11px;
        font-weight: 850;
    }

    .footer-separator {
        padding: 0 3px;
        color: #a1adbd;
    }

    .footer-meta {
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
        font-size: 10px;
    }

    .footer-bullet {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #9aa7b8;
    }

    #blazor-error-ui {
        position: fixed;
        right: 18px;
        bottom: 18px;
        left: 18px;
        z-index: 1000;
        padding: 15px 18px;
        display: none;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        color: #7b2525;
        background: #fff5f4;
        border: 1px solid #f0c0bc;
        border-radius: 10px;
        box-shadow: 0 8px 30px rgb(16 26 46 / 14%);
    }

        #blazor-error-ui .error-ui-content {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        #blazor-error-ui .error-ui-icon {
            width: 28px;
            height: 28px;
            flex: 0 0 28px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            color: #fff;
            background: #b93832;
            font-weight: 850;
        }

        #blazor-error-ui .error-ui-content span:last-child {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        #blazor-error-ui .error-ui-content strong {
            font-size: 12px;
        }

        #blazor-error-ui .error-ui-content small {
            color: #8e5652;
            font-size: 11px;
        }

        #blazor-error-ui .error-ui-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        #blazor-error-ui .reload {
            color: #245fc1;
            font-size: 12px;
            font-weight: 800;
            text-decoration: none;
            white-space: nowrap;
        }

            #blazor-error-ui .reload:hover {
                text-decoration: underline;
            }

        #blazor-error-ui .dismiss {
            width: 28px;
            height: 28px;
            border: 0;
            border-radius: 6px;
            color: #7b2525;
            background: transparent;
            font-size: 22px;
            cursor: pointer;
        }

            #blazor-error-ui .dismiss:hover {
                background: #ffe5e2;
            }

    @@media (min-width: 1500px) {
        .app-topbar,
        .app-footer {
            padding-right: max(34px, calc((100vw - 1600px) / 2));
            padding-left: max(34px, calc((100vw - 1600px) / 2));
        }

        .app-main {
            padding-right: max(34px, calc((100vw - 1600px) / 2));
            padding-left: max(34px, calc((100vw - 1600px) / 2));
        }
    }

    @@media (max-width: 760px) {
        .app-topbar {
            min-height: 70px;
            padding: 0 20px;
        }

        .gateway-status-label,
        .gateway-status-divider {
            display: none;
        }

        .app-main {
            padding: 24px 20px;
        }

        .app-footer {
            padding: 15px 20px;
        }
    }

    @@media (max-width: 480px) {
        .app-topbar {
            padding: 0 14px;
        }

        .brand-mark {
            width: 37px;
            height: 37px;
            flex-basis: 37px;
        }

        .brand-name {
            font-size: 14px;
        }

        .brand-subtitle {
            font-size: 10px;
        }

        .gateway-status {
            gap: 7px;
            font-size: 10px;
        }

        .app-main {
            padding: 20px 14px;
        }

        .app-footer {
            align-items: flex-start;
            flex-direction: column;
            padding: 14px;
            gap: 10px;
        }

        .footer-meta {
            justify-content: flex-start;
        }

        #blazor-error-ui {
            right: 10px;
            bottom: 10px;
            left: 10px;
            align-items: flex-start;
            padding: 12px;
            gap: 10px;
        }

            #blazor-error-ui .error-ui-content small {
                max-width: 190px;
                line-height: 1.4;
            }

            #blazor-error-ui .error-ui-actions {
                gap: 7px;
            }

            #blazor-error-ui .reload {
                font-size: 10px;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
        }
    }
</style>