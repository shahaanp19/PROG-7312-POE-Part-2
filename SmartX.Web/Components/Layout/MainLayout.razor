@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-topbar">
        <a class="brand" href="/" aria-label="Smart-X dashboard">
            <span class="brand-mark" aria-hidden="true">S</span>

            <span class="brand-copy">
                <span class="brand-name">SMART-X</span>
                <span class="brand-subtitle">IoT Gateway Ecosystem</span>
            </span>
        </a>

        <div class="gateway-status" aria-label="Gateway interface">
            <span class="status-dot" aria-hidden="true"></span>
            <span>Gateway Interface</span>
            <span class="gateway-status-divider" aria-hidden="true"></span>
            <span class="gateway-status-label">MODULAR OPERATIONS</span>
        </div>
    </header>

    <NavMenu />

    <main class="app-main" id="main-content" tabindex="-1">
        @Body
    </main>

    <footer class="app-footer">
        <div class="footer-brand">
            <span class="footer-mark" aria-hidden="true">S</span>
            <span>
                SMART-X <span class="footer-separator">/</span> IoT GATEWAY
            </span>
        </div>

        <div class="footer-meta">
            <span>Telemetry</span>
            <span class="footer-bullet" aria-hidden="true"></span>
            <span>Command Operations</span>
            <span class="footer-bullet" aria-hidden="true"></span>
            <span>Mesh Ecosystem</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet role="alert">
    <div class="error-ui-content">
        <span class="error-ui-icon" aria-hidden="true">!</span>
        <span class="error-ui-message">
            <strong>Connection interrupted</strong>
            <small>An unexpected application error occurred.</small>
        </span>
    </div>

    <div class="error-ui-actions">
        <a href="" class="reload">Reload application</a>
        <button type="button"
                class="dismiss"
                aria-label="Dismiss error notification"
                onclick="document.getElementById('blazor-error-ui').style.display='none'">
            ×
        </button>
    </div>
</div>

<style>
    .app-shell {
        --sx-navy: #111c31;
        --sx-navy-soft: #192943;
        --sx-blue: #3978ed;
        --sx-blue-light: #eaf1ff;
        --sx-text: #1b2940;
        --sx-muted: #738198;
        --sx-border: #e4eaf2;
        --sx-surface: #ffffff;
        --sx-background: #f5f7fb;
        --sx-green: #24b47e;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        color: var(--sx-text);
        background: var(--sx-background);
        font-family: Inter, "Segoe UI", Arial, sans-serif;
        font-size: 14px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
    }

        .app-shell *,
        .app-shell *::before,
        .app-shell *::after {
            box-sizing: border-box;
        }

    .app-topbar {
        position: relative;
        z-index: 10;
        min-height: 76px;
        padding: 0 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        color: #fff;
        background: var(--sx-navy);
        border-bottom: 3px solid var(--sx-blue);
    }

    .brand {
        min-width: 0;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: inherit;
        text-decoration: none;
        border-radius: 8px;
    }

        .brand:focus-visible {
            outline: 2px solid #9bbcff;
            outline-offset: 5px;
        }

    .brand-mark {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: grid;
        place-items: center;
        border: 1px solid rgb(255 255 255 / 16%);
        border-radius: 12px;
        color: #fff;
        background: linear-gradient(145deg, #4988ff, #2862d5);
        box-shadow: 0 4px 14px rgb(0 0 0 / 15%);
        font-size: 23px;
        font-weight: 850;
        line-height: 1;
    }

    .brand-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 3px;
    }

    .brand-name {
        color: #fff;
        font-size: 16px;
        font-weight: 850;
        line-height: 1.2;
        letter-spacing: 2px;
    }

    .brand-subtitle {
        color: #aab8ce;
        font-size: 11px;
        font-weight: 400;
        line-height: 1.4;
        letter-spacing: .2px;
    }

    .gateway-status {
        min-width: 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        color: #dbe4f1;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        flex: 0 0 8px;
        border-radius: 50%;
        background: var(--sx-green);
        box-shadow: 0 0 0 4px rgb(36 180 126 / 13%);
    }

    .gateway-status-divider {
        width: 1px;
        height: 18px;
        flex: 0 0 1px;
        margin: 0 2px;
        background: rgb(255 255 255 / 20%);
    }

    .gateway-status-label {
        color: #9eafc8;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .app-main {
        width: 100%;
        max-width: 1720px;
        min-width: 0;
        flex: 1 0 auto;
        margin: 0 auto;
        padding: 30px 34px;
        outline: none;
    }

        .app-main:focus {
            outline: none;
            }

        .app-footer {
            width: 100%;
            min-height: 57px;
            padding: 15px 34px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            color: var(--sx-muted);
            background: var(--sx-surface);
            border-top: 1px solid var(--sx-border);
            font-size: 10px;
            line-height: 1.5;
        }

        .footer-brand,
        .footer-meta {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .footer-brand {
            color: #47566d;
            font-size: 9px;
            font-weight: 850;
            letter-spacing: .65px;
            white-space: nowrap;
        }

        .footer-mark {
            width: 21px;
            height: 21px;
            flex: 0 0 21px;
            display: grid;
            place-items: center;
            border-radius: 6px;
            color: #fff;
            background: var(--sx-navy);
            font-size: 11px;
            font-weight: 850;
            line-height: 1;
        }

        .footer-separator {
            padding: 0 3px;
            color: #a1adbd;
        }

        .footer-meta {
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 8px;
            color: #738198;
            font-size: 10px;
        }

        .footer-bullet {
            width: 3px;
            height: 3px;
            flex: 0 0 3px;
            border-radius: 50%;
            background: #9aa7b8;
        }

        #blazor-error-ui {
            position: fixed;
            right: 18px;
            bottom: 18px;
            left: 18px;
            z-index: 10000;
            padding: 15px 18px;
            display: none;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            color: #7b2525;
            background: #fff5f4;
            border: 1px solid #f0c0bc;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgb(16 26 46 / 14%);
            font-family: Inter, "Segoe UI", Arial, sans-serif;
        }

            #blazor-error-ui .error-ui-content {
                min-width: 0;
                display: flex;
                align-items: center;
                gap: 11px;
            }

            #blazor-error-ui .error-ui-icon {
                width: 28px;
                height: 28px;
                flex: 0 0 28px;
                display: grid;
                place-items: center;
                border-radius: 50%;
                color: #fff;
                background: #b93832;
                font-size: 14px;
                font-weight: 850;
                line-height: 1;
            }

            #blazor-error-ui .error-ui-message {
                min-width: 0;
                display: flex;
                flex-direction: column;
                gap: 3px;
            }

                #blazor-error-ui .error-ui-message strong {
                    color: #7b2525;
                    font-size: 12px;
                    font-weight: 750;
                    line-height: 1.4;
                }

                #blazor-error-ui .error-ui-message small {
                    color: #8e5652;
                    font-size: 11px;
                    line-height: 1.5;
                }

            #blazor-error-ui .error-ui-actions {
                flex: 0 0 auto;
                display: flex;
                align-items: center;
                gap: 15px;
            }

            #blazor-error-ui .reload {
                color: #245fc1;
                font-size: 12px;
                font-weight: 800;
                text-decoration: none;
                white-space: nowrap;
            }

                #blazor-error-ui .reload:hover {
                    text-decoration: underline;
                }

                #blazor-error-ui .reload:focus-visible,
                #blazor-error-ui .dismiss:focus-visible {
                    outline: 2px solid #245fc1;
                    outline-offset: 3px;
                }

            #blazor-error-ui .dismiss {
                width: 28px;
                height: 28px;
                flex: 0 0 28px;
                display: grid;
                place-items: center;
                border: 0;
                border-radius: 6px;
                color: #7b2525;
                background: transparent;
                font-family: inherit;
                font-size: 22px;
                line-height: 1;
                cursor: pointer;
            }

                #blazor-error-ui .dismiss:hover {
                    background: #ffe5e2;
                }

        @@media (min-width: 1500px) {
            .app-topbar,
            .app-footer {
                padding-right: max(34px, calc((100vw - 1652px) / 2));
                padding-left: max(34px, calc((100vw - 1652px) / 2));
            }
        }

        @@media (max-width: 1000px) {
            .app-topbar {
                padding-right: 24px;
                padding-left: 24px;
            }

            .app-main {
                padding: 26px 24px;
            }

            .app-footer {
                padding-right: 24px;
                padding-left: 24px;
            }

            .gateway-status {
                gap: 8px;
            }

            .gateway-status-label {
                font-size: 8px;
                letter-spacing: .7px;
            }
        }

        @@media (max-width: 760px) {
            .app-topbar {
                min-height: 70px;
                padding: 0 20px;
                gap: 16px;
            }

            .gateway-status-label,
            .gateway-status-divider {
                display: none;
            }

            .app-main {
                padding: 24px 20px;
            }

            .app-footer {
                padding: 15px 20px;
            }

            .footer-meta {
                gap: 7px;
            }
        }

    @@media (max-width: 560px) {
        .app-topbar {
            align-items: center;
            padding: 0 16px;
            gap: 10px;
        }

        .brand {
            gap: 9px;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            flex-basis: 38px;
            border-radius: 10px;
            font-size: 21px;
        }

        .brand-name {
            font-size: 14px;
            letter-spacing: 1.6px;
        }

        .brand-subtitle {
            font-size: 10px;
        }

        .gateway-status {
            gap: 7px;
            font-size: 10px;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            flex-basis: 7px;
        }

        .app-main {
            padding: 20px 16px;
        }

        .app-footer {
            align-items: flex-start;
            flex-direction: column;
            padding: 14px 16px;
            gap: 10px;
        }

        .footer-meta {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 380px) {
        .app-topbar {
            padding-right: 12px;
            padding-left: 12px;
        }

        .brand {
            gap: 7px;
        }

        .brand-mark {
            width: 34px;
            height: 34px;
            flex-basis: 34px;
            font-size: 19px;
        }

        .brand-name {
            font-size: 12px;
            letter-spacing: 1.2px;
        }

        .brand-subtitle {
            font-size: 9px;
        }

        .gateway-status {
            gap: 6px;
            font-size: 9px;
        }

        .app-main {
            padding: 18px 12px;
        }

        .app-footer {
            padding: 13px 12px;
        }

        #blazor-error-ui {
            right: 10px;
            bottom: 10px;
            left: 10px;
            padding: 12px;
            gap: 10px;
        }

            #blazor-error-ui .error-ui-message small {
                max-width: 190px;
                line-height: 1.4;
            }

            #blazor-error-ui .error-ui-actions {
                gap: 7px;
            }

            #blazor-error-ui .reload {
                font-size: 10px;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        .app-shell *,
        .app-shell *::before,
        .app-shell *::after {
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
        }
    }
</style>
