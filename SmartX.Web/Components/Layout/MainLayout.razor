@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="app-shell">
    <header class="app-topbar">
        <a class="brand" href="/" aria-label="Smart-X dashboard">
            <span class="brand-mark">S</span>
            <span class="brand-copy">
                <span class="brand-name">SMART-X</span>
                <span class="brand-subtitle">IoT Gateway Ecosystem</span>
            </span>
        </a>

        <div class="gateway-status" aria-label="Gateway interface status">
            <span class="status-dot" aria-hidden="true"></span>
            <span>Gateway Interface</span>
            <span class="gateway-status-divider" aria-hidden="true"></span>
            <span class="gateway-status-label">MODULAR OPERATIONS</span>
        </div>
    </header>

    <nav class="pillar-nav" aria-label="Main menu">
        <div class="nav-heading-row">
            <div>
                <div class="nav-eyebrow">SMART-X PLATFORM</div>
                <h2 class="nav-heading">Ecosystem Modules</h2>
            </div>
            <span class="module-counter">02 / 03 AVAILABLE</span>
        </div>

        <div class="nav-items">
            <NavLink href="/"
                     Match="NavLinkMatch.All"
                     class="@Part1Class"
                     aria-current="@Part1AriaCurrent"
                     title="Open the sensor telemetry dashboard">
                <span class="nav-number">01</span>
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M3 12h3l3-8 5 16 3-8h4"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>
                </span>
                <span class="nav-label">
                    <strong>Sensor &amp; Telemetry</strong>
                    <small>Part 1 · Data ingestion</small>
                </span>
                <span class="nav-status">
                    <span class="nav-status-dot" aria-hidden="true"></span>
                    AVAILABLE
                </span>
            </NavLink>

            <NavLink href="/commands"
                     Match="NavLinkMatch.Prefix"
                     class="@Part2Class"
                     aria-current="@Part2AriaCurrent"
                     title="Open command operations, queue management and history">
                <span class="nav-number">02</span>
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M4 5h16M4 12h10M4 19h16"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round" />
                        <circle cx="18" cy="12" r="2"
                                stroke="currentColor"
                                stroke-width="1.8" />
                    </svg>
                </span>
                <span class="nav-label">
                    <strong>Command Stream</strong>
                    <small>Part 2 · Commands &amp; history</small>
                </span>
                <span class="nav-status">
                    <span class="nav-status-dot" aria-hidden="true"></span>
                    AVAILABLE
                </span>
            </NavLink>

            <button type="button"
                    class="nav-item nav-disabled"
                    disabled
                    aria-disabled="true"
                    title="Network topology will be available in the final PoE">
                <span class="nav-number">03</span>
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="5" r="2.5"
                                stroke="currentColor"
                                stroke-width="1.7" />
                        <circle cx="5" cy="19" r="2.5"
                                stroke="currentColor"
                                stroke-width="1.7" />
                        <circle cx="19" cy="19" r="2.5"
                                stroke="currentColor"
                                stroke-width="1.7" />
                        <path d="M10.8 7.2 6.2 16.7M13.2 7.2l4.6 9.5M7.5 19h9"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round" />
                    </svg>
                </span>
                <span class="nav-label">
                    <strong>Network Topology</strong>
                    <small>Part 3 · Mesh visualization</small>
                </span>
                <span class="nav-status coming-soon">LOCKED</span>
            </button>
        </div>

        <div class="nav-footer">
            <span class="nav-footer-indicator" aria-hidden="true"></span>
            <span>Navigation preserves the active application session.</span>
        </div>
    </nav>

    <main class="app-main" id="main-content" tabindex="-1">
        @Body
    </main>

    <footer class="app-footer">
        <div class="footer-brand">
            <span class="footer-mark">S</span>
            <span>SMART-X <span class="footer-separator">/</span> IoT GATEWAY</span>
        </div>
        <div class="footer-meta">
            <span>Telemetry</span>
            <span class="footer-bullet" aria-hidden="true"></span>
            <span>Command Operations</span>
            <span class="footer-bullet" aria-hidden="true"></span>
            <span>Mesh Ecosystem</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <div class="error-ui-content">
        <span class="error-ui-icon" aria-hidden="true">!</span>
        <span>
            <strong>Connection interrupted</strong>
            <small>An unexpected application error occurred.</small>
        </span>
    </div>
    <div class="error-ui-actions">
        <a href="" class="reload">Reload application</a>
        <button type="button"
                class="dismiss"
                aria-label="Dismiss error notification">
            ×
        </button>
    </div>
</div>

<style>
    :root {
        --sx-navy: #101a2e;
        --sx-navy-raised: #182640;
        --sx-blue: #3978ed;
        --sx-blue-strong: #245fd1;
        --sx-blue-soft: #edf3ff;
        --sx-text: #19243a;
        --sx-muted: #718096;
        --sx-border: #e2e8f0;
        --sx-surface: #ffffff;
        --sx-background: #f4f7fb;
        --sx-green: #20a875;
        --sx-radius: 12px;
        --sx-transition: 160ms ease;
    }

    .app-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        color: var(--sx-text);
        background: var(--sx-background);
        font-family: Inter, "Segoe UI", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    .app-topbar {
        position: relative;
        z-index: 2;
        min-height: 78px;
        padding: 0 34px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        color: #fff;
        background: var(--sx-navy);
        border-bottom: 3px solid var(--sx-blue);
    }

    .brand {
        min-width: 0;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: inherit;
        text-decoration: none;
        border-radius: 8px;
    }

        .brand:focus-visible {
            outline: 2px solid #9bbcff;
            outline-offset: 5px;
        }

    .brand-mark {
        width: 43px;
        height: 43px;
        flex: 0 0 43px;
        display: grid;
        place-items: center;
        border: 1px solid rgb(255 255 255 / 16%);
        border-radius: 12px;
        color: #fff;
        background: linear-gradient(145deg, #4988ff, #2862d5);
        box-shadow: 0 4px 14px rgb(0 0 0 / 15%);
        font-size: 23px;
        font-weight: 850;
    }

    .brand-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .brand-name {
        font-size: 17px;
        font-weight: 850;
        letter-spacing: 2px;
    }

    .brand-subtitle {
        color: #aab8ce;
        font-size: 11px;
        letter-spacing: .25px;
    }

    .gateway-status {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #dbe4f1;
        font-size: 12px;
        font-weight: 600;
    }

    .status-dot,
    .nav-status-dot,
    .nav-footer-indicator {
        width: 8px;
        height: 8px;
        flex: 0 0 8px;
        border-radius: 50%;
        background: var(--sx-green);
    }

    .status-dot {
        box-shadow: 0 0 0 4px rgb(32 168 117 / 13%);
    }

    .gateway-status-divider {
        width: 1px;
        height: 18px;
        margin: 0 2px;
        background: rgb(255 255 255 / 20%);
    }

    .gateway-status-label {
        color: #9eafc8;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .pillar-nav {
        padding: 24px 34px 18px;
        background: var(--sx-surface);
        border-bottom: 1px solid var(--sx-border);
    }

    .nav-heading-row {
        margin-bottom: 16px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
    }

    .nav-eyebrow {
        margin-bottom: 5px;
        color: var(--sx-blue-strong);
        font-size: 9px;
        font-weight: 850;
        letter-spacing: 1.6px;
    }

    .nav-heading {
        margin: 0;
        color: var(--sx-text);
        font-size: 17px;
        font-weight: 800;
        letter-spacing: -.35px;
    }

    .module-counter {
        padding: 6px 9px;
        border: 1px solid var(--sx-border);
        border-radius: 6px;
        color: var(--sx-muted);
        background: #f8fafc;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .65px;
        white-space: nowrap;
    }

    .nav-items {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .nav-item {
        position: relative;
        min-width: 0;
        min-height: 86px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 11px;
        overflow: hidden;
        border: 1px solid var(--sx-border);
        border-radius: var(--sx-radius);
        color: var(--sx-text);
        background: #fff;
        text-align: left;
        text-decoration: none;
        transition: border-color var(--sx-transition), background var(--sx-transition), box-shadow var(--sx-transition), transform var(--sx-transition);
    }

    a.nav-item:hover {
        border-color: #b5ccfa;
        background: #fafcff;
    }

    a.nav-item:focus-visible {
        outline: 3px solid rgb(57 120 237 / 35%);
        outline-offset: 3px;
    }

    .nav-item.pillar-selected {
        border-color: var(--sx-blue);
        background: var(--sx-blue-soft);
        box-shadow: inset 0 0 0 1px var(--sx-blue);
    }

    .nav-number {
        width: 29px;
        height: 29px;
        flex: 0 0 29px;
        display: grid;
        place-items: center;
        border: 1px solid #e1e7f0;
        border-radius: 8px;
        color: #68778d;
        background: #f1f4f8;
        font-size: 10px;
        font-weight: 850;
        font-variant-numeric: tabular-nums;
    }

    .pillar-selected .nav-number {
        border-color: var(--sx-blue);
        color: #fff;
        background: var(--sx-blue);
    }

    .nav-icon {
        width: 31px;
        height: 31px;
        flex: 0 0 31px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        color: #65758e;
        background: #f3f6fa;
    }

        .nav-icon svg {
            width: 19px;
            height: 19px;
        }

    .pillar-selected .nav-icon {
        color: var(--sx-blue-strong);
        background: #dce8ff;
    }

    .nav-label {
        min-width: 0;
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .nav-label strong {
            overflow: hidden;
            color: #26344a;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.4;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .nav-label small {
            overflow: hidden;
            color: var(--sx-muted);
            font-size: 10px;
            line-height: 1.4;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .nav-status {
        align-self: flex-start;
        flex: 0 0 auto;
        padding: 5px 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 1px solid #d3eee3;
        border-radius: 5px;
        color: #197b58;
        background: #effaf5;
        font-size: 8px;
        font-weight: 850;
        letter-spacing: .3px;
        white-space: nowrap;
    }

    .nav-status-dot {
        width: 6px;
        height: 6px;
        flex-basis: 6px;
    }

    .nav-disabled {
        cursor: not-allowed;
        opacity: .57;
    }

        .nav-disabled .nav-number,
        .nav-disabled .nav-icon {
            color: #7b8798;
            background: #edf0f4;
        }

    .coming-soon {
        border-color: #e2e7ee;
        color: #687386;
        background: #f0f2f5;
    }

    .nav-footer {
        margin-top: 13px;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--sx-muted);
        font-size: 10px;
    }

    .nav-footer-indicator {
        width: 6px;
        height: 6px;
        flex-basis: 6px;
        background: #7c94b9;
    }

    .app-main {
        width: 100%;
        flex: 1 0 auto;
        padding: 30px 34px;
        outline: none;
    }

    .app-footer {
        min-height: 57px;
        padding: 16px 34px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        color: var(--sx-muted);
        background: var(--sx-surface);
        border-top: 1px solid var(--sx-border);
        font-size: 10px;
    }

    .footer-brand,
    .footer-meta {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .footer-brand {
        color: #47566d;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: .65px;
    }

    .footer-mark {
        width: 20px;
        height: 20px;
        display: grid;
        place-items: center;
        border-radius: 5px;
        color: #fff;
        background: var(--sx-navy);
        font-size: 11px;
        font-weight: 850;
    }

    .footer-separator {
        padding: 0 3px;
        color: #a1adbd;
    }

    .footer-meta {
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
        font-size: 10px;
    }

    .footer-bullet {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #9aa7b8;
    }

    #blazor-error-ui {
        position: fixed;
        right: 18px;
        bottom: 18px;
        left: 18px;
        z-index: 1000;
        padding: 15px 18px;
        display: none;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        color: #7b2525;
        background: #fff5f4;
        border: 1px solid #f0c0bc;
        border-radius: 10px;
        box-shadow: 0 8px 30px rgb(16 26 46 / 14%);
    }

        #blazor-error-ui .error-ui-content {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        #blazor-error-ui .error-ui-icon {
            width: 28px;
            height: 28px;
            flex: 0 0 28px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            color: #fff;
            background: #b93832;
            font-weight: 850;
        }

        #blazor-error-ui .error-ui-content span:last-child {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        #blazor-error-ui .error-ui-content strong {
            font-size: 12px;
        }

        #blazor-error-ui .error-ui-content small {
            color: #8e5652;
            font-size: 11px;
        }

        #blazor-error-ui .error-ui-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        #blazor-error-ui .reload {
            color: #245fc1;
            font-size: 12px;
            font-weight: 800;
            text-decoration: none;
            white-space: nowrap;
        }

            #blazor-error-ui .reload:hover {
                text-decoration: underline;
            }

        #blazor-error-ui .dismiss {
            width: 28px;
            height: 28px;
            border: 0;
            border-radius: 6px;
            color: #7b2525;
            background: transparent;
            font-size: 22px;
            cursor: pointer;
        }

            #blazor-error-ui .dismiss:hover {
                background: #ffe5e2;
            }

    @@media (min-width: 1500px) {
        .app-topbar,
        .pillar-nav,
        .app-footer {
            padding-right: max(34px, calc((100vw - 1600px) / 2));
            padding-left: max(34px, calc((100vw - 1600px) / 2));
        }

        .app-main {
            padding-right: max(34px, calc((100vw - 1600px) / 2));
            padding-left: max(34px, calc((100vw - 1600px) / 2));
        }
    }

    @@media (max-width: 1100px) {
        .nav-items {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .nav-disabled {
            grid-column: 1 / -1;
        }

        .nav-item {
            min-height: 76px;
        }
    }

    @@media (max-width: 760px) {
        .app-topbar {
            min-height: 70px;
            padding: 0 20px;
        }

        .gateway-status-label,
        .gateway-status-divider {
            display: none;
        }

        .pillar-nav {
            padding: 21px 20px 16px;
        }

        .nav-items {
            grid-template-columns: 1fr;
            gap: 9px;
        }

        .nav-disabled {
            grid-column: auto;
        }

        .nav-item {
            min-height: 69px;
        }

        .app-main {
            padding: 24px 20px;
        }

        .app-footer {
            padding: 15px 20px;
        }
    }

    @@media (max-width: 480px) {
        .app-topbar {
            padding: 0 14px;
        }

        .brand-mark {
            width: 37px;
            height: 37px;
            flex-basis: 37px;
        }

        .brand-name {
            font-size: 14px;
        }

        .brand-subtitle {
            font-size: 10px;
        }

        .gateway-status {
            gap: 7px;
            font-size: 10px;
        }

        .pillar-nav {
            padding: 18px 14px 14px;
        }

        .nav-heading {
            font-size: 15px;
        }

        .module-counter {
            font-size: 8px;
        }

        .nav-item {
            padding: 12px 10px;
            gap: 8px;
        }

        .nav-number {
            width: 26px;
            height: 26px;
            flex-basis: 26px;
        }

        .nav-icon {
            width: 27px;
            height: 27px;
            flex-basis: 27px;
        }

        .nav-label strong {
            font-size: 11px;
        }

        .nav-label small {
            font-size: 9px;
        }

        .nav-status {
            padding: 4px;
            font-size: 7px;
        }

        .nav-footer {
            align-items: flex-start;
            line-height: 1.5;
        }

        .app-main {
            padding: 20px 14px;
        }

        .app-footer {
            align-items: flex-start;
            flex-direction: column;
            padding: 14px;
            gap: 10px;
        }

        .footer-meta {
            justify-content: flex-start;
        }

        #blazor-error-ui {
            right: 10px;
            bottom: 10px;
            left: 10px;
            align-items: flex-start;
            padding: 12px;
            gap: 10px;
        }

            #blazor-error-ui .error-ui-content small {
                max-width: 190px;
                line-height: 1.4;
            }

            #blazor-error-ui .error-ui-actions {
                gap: 7px;
            }

            #blazor-error-ui .reload {
                font-size: 10px;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
        }
    }
</style>

@code {
    private string CurrentPillar { get; set; } = "part1";

    private string Part1Class =>
        CurrentPillar == "part1"
            ? "nav-item pillar-selected"
            : "nav-item";

    private string Part2Class =>
        CurrentPillar == "part2"
            ? "nav-item pillar-selected"
            : "nav-item";

    private string? Part1AriaCurrent =>
        CurrentPillar == "part1" ? "page" : null;

    private string? Part2AriaCurrent =>
        CurrentPillar == "part2" ? "page" : null;

    protected override void OnInitialized()
    {
        UpdateCurrentPillar();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            UpdateCurrentPillar();
            StateHasChanged();
        });
    }

    private void UpdateCurrentPillar()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);

        var queryIndex = relativePath.IndexOf('?');
        if (queryIndex >= 0)
        {
            relativePath = relativePath[..queryIndex];
        }

        var fragmentIndex = relativePath.IndexOf('#');
        if (fragmentIndex >= 0)
        {
            relativePath = relativePath[..fragmentIndex];
        }

        var path = relativePath.Trim('/');

        CurrentPillar =
            path.Equals("commands", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("commands/", StringComparison.OrdinalIgnoreCase)
            || path.Equals("command-history", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("command-history/", StringComparison.OrdinalIgnoreCase)
                ? "part2"
                : "part1";
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
