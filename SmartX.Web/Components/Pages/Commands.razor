@code {
    private string _deviceId = string.Empty;
    private string _selectedCommand = "RequestTelemetry";
    private string _selectedPriority = "Normal";
    private string _parameters = string.Empty;
    private string _feedback = string.Empty;
    private string _searchQuery = string.Empty;
    private string _analysisQuery = string.Empty;
    private string _errorKey = string.Empty;
    private bool _isError;

    private IReadOnlyList<SmartX.Web.Services.SmartXRecommendation> Recommendations =>
        RecommendationEngine.Generate(searchQuery: _analysisQuery);

    protected override void OnInitialized()
    {
        CommandState.StateChanged += OnStateChanged;
    }

    private Task SubmitCommandAsync()
    {
        if (string.IsNullOrWhiteSpace(_deviceId))
        {
            SetFeedback("Enter a device or sensor ID.", true);
            return Task.CompletedTask;
        }

        try
        {
            CommandState.Enqueue(
                _deviceId,
                _selectedCommand,
                _selectedPriority,
                _parameters);

            SetFeedback($"Command queued for {_deviceId.Trim()}.", false);
            _deviceId = string.Empty;
            _parameters = string.Empty;
        }
        catch (ArgumentException ex)
        {
            SetFeedback(ex.Message, true);
        }

        return Task.CompletedTask;
    }

    private void RefreshRecommendations()
    {
        _analysisQuery = _searchQuery.Trim();
    }

    private void ProcessNext()
    {
        var record = CommandState.ProcessNext();

        SetFeedback(
            record is null
                ? "There are no commands to process."
                : $"Processed command for {record.DeviceId} locally using FIFO order.",
            record is null);
    }

    private void ProcessHighestPriority()
    {
        var record = CommandState.ProcessHighestPriority();

        SetFeedback(
            record is null
                ? "There are no pending commands to process."
                : $"Processed {record.Priority}-priority command '{record.Command}' for {record.DeviceId} locally.",
            record is null);
    }

    private void UndoLast()
    {
        var record = CommandState.UndoLast();

        SetFeedback(
            record is null
                ? "No queued command is available to undo."
                : $"Undo recorded for {record.DeviceId}.",
            record is null);
    }

    private void ClearQueue()
    {
        var count = CommandState.ClearQueue();

        SetFeedback(
            count == 0
                ? "The queue is already empty."
                : $"Cleared {count} pending command(s). History was retained.",
            count == 0);
    }

    private void RecordError()
    {
        if (string.IsNullOrWhiteSpace(_errorKey))
        {
            SetFeedback("Enter an error key to record.", true);
            return;
        }

        var key = _errorKey.Trim();
        var alreadyExists = CommandState.ActiveErrors.Contains(key);

        CommandState.RecordActiveError(key);

        SetFeedback(
            alreadyExists
                ? $"Error '{key}' is already active."
                : $"Recorded active error '{key}'.",
            alreadyExists);

        _errorKey = string.Empty;
    }

    private void ResolveError(string errorKey)
    {
        var resolved = CommandState.ResolveActiveError(errorKey);

        SetFeedback(
            resolved
                ? $"Resolved error '{errorKey}'."
                : $"Error '{errorKey}' was not active.",
            !resolved);
    }

    private void SetFeedback(string message, bool isError)
    {
        _feedback = message;
        _isError = isError;
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string DisplayOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string RecommendationKey(
        SmartX.Web.Services.SmartXRecommendation recommendation) =>
        $"{recommendation.Title}|{recommendation.DeviceId}";

    private static string SeverityLabel(
        SmartX.Web.Services.RecommendationSeverity severity) =>
        severity switch
        {
            SmartX.Web.Services.RecommendationSeverity.Critical => "CRITICAL",
            SmartX.Web.Services.RecommendationSeverity.Warning => "WARNING",
            _ => "INFO"
        };

    private static string SeverityClass(
        SmartX.Web.Services.RecommendationSeverity severity) =>
        severity switch
        {
            SmartX.Web.Services.RecommendationSeverity.Critical => "severity-critical",
            SmartX.Web.Services.RecommendationSeverity.Warning => "severity-warning",
            _ => "severity-info"
        };

    private static string PriorityClass(string priority) =>
        priority.ToLowerInvariant() switch
        {
            "critical" => "priority-critical",
            "high" => "priority-high",
            _ => "priority-normal"
        };

    private static string StatusClass(string status) =>
        status.ToLowerInvariant() switch
        {
            "queued" => "status-queued",
            "processed locally" => "status-processed",
            "undone" => "status-undone",
            "cleared" => "status-cleared",
            _ => "status-queued"
        };

    public void Dispose()
    {
        CommandState.StateChanged -= OnStateChanged;
    }
}
