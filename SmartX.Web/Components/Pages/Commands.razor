    private IReadOnlyList<CommandRecord> PendingCommands =>
        CommandState.Queue.ToArray();

    private IReadOnlyList<CommandRecord> RecentHistory =>
        CommandState.History.Take(10).ToArray();

    private IReadOnlyCollection<string> ActiveErrors =>
        CommandState.ActiveErrors;

    protected override void OnInitialized()
    {
        CommandState.StateChanged += HandleStateChanged;
    }

    private void DismissMessage()
    {
        _message = string.Empty;
    }

    private void SubmitCommand()
    {
        try
        {
            var record = CommandState.Enqueue(
                _deviceId,
                _command,
                _priority,
                _parameters);

            _message =
                $"{record.Priority} command '{record.Command}' queued for {record.DeviceId}.";

            _deviceId = string.Empty;
            _command = string.Empty;
            _parameters = string.Empty;
            _priority = "Normal";
        }
        catch (ArgumentException ex)
        {
            _message = ex.Message;
        }
    }

    private async Task SubmitCriticalAlert()
    {
        if (_submittingAlert)
        {
            return;
        }

        var deviceId = _deviceId.Trim();
        var command = _command.Trim();

        if (string.IsNullOrWhiteSpace(deviceId) ||
            string.IsNullOrWhiteSpace(command))
        {
            _message =
                "Enter a device ID and alert command before ingesting a critical alert.";
            return;
        }

        _submittingAlert = true;

        try
        {
            await AlertStream.SubmitAsync(
                deviceId,
                command,
                _parameters);

            _message =
                $"Critical alert accepted into the ingestion stream for {deviceId}.";

            _deviceId = string.Empty;
            _command = string.Empty;
            _parameters = string.Empty;
            _priority = "Normal";
        }
        catch (ArgumentException ex)
        {
            _message = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _message = $"Critical-alert stream unavailable: {ex.Message}";
        }
        finally
        {
            _submittingAlert = false;
        }
    }

    private void ProcessNext()
    {
        var record = CommandState.ProcessNext();

        _message = record is null
            ? "No pending commands to process."
            : $"FIFO processed '{record.Command}' for {record.DeviceId}.";
    }

    private void ProcessHighestPriority()
    {
        var record = CommandState.ProcessHighestPriority();

        _message = record is null
            ? "No pending commands to process."
            : $"Priority scheduler processed {record.Priority} command '{record.Command}' for {record.DeviceId}.";
    }

    private void UndoLast()
    {
        var record = CommandState.UndoLast();

        _message = record is null
            ? "No pending command is available to undo."
            : $"Undid pending command '{record.Command}' for {record.DeviceId}.";
    }

    private void ClearQueue()
    {
        var count = CommandState.ClearQueue();
        _message = $"Cleared {count} pending command(s).";
    }

    private void RecordError()
    {
        if (string.IsNullOrWhiteSpace(_errorKey))
        {
            _message = "Enter an error key.";
            return;
        }

        var key = _errorKey.Trim();
        var existed = ActiveErrors.Contains(
            key,
            StringComparer.OrdinalIgnoreCase);

        CommandState.RecordActiveError(key);

        _message = existed
            ? $"Error '{key}' is already active."
            : $"Recorded active error '{key}'.";

        _errorKey = string.Empty;
    }

    private void ResolveError(string error)
    {
        var resolved = CommandState.ResolveActiveError(error);

        _message = resolved
            ? $"Resolved error '{error}'."
            : $"Error '{error}' was not active.";
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string PriorityClass(string priority) =>
        priority.ToLowerInvariant() switch
        {
            "critical" => "priority-critical",
            "high" => "priority-high",
            _ => "priority-normal"
        };

    private static string StatusClass(string status) =>
        status.ToLowerInvariant() switch
        {
            "queued" => "status-queued",
            "processed locally" => "status-processed",
            "undone" => "status-undone",
            "cleared" => "status-cleared",
            _ => "status-queued"
        };

    private static string SeverityClass(
        RecommendationSeverity severity) =>
        severity switch
        {
            RecommendationSeverity.Critical => "severity-critical",
            RecommendationSeverity.Warning => "severity-warning",
            _ => "severity-info"
        };

    public void Dispose()
    {
        CommandState.StateChanged -= HandleStateChanged;
    }
}
