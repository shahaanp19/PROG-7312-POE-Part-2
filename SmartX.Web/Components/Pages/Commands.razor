@page "/commands"
@using System
@using System.Linq
@using System.Threading.Tasks
@using SmartX.Web.Services
@implements IDisposable
@inject CommandStateService CommandState
@inject RecommendationEngine Recommendations
@inject CriticalAlertStreamService AlertStream

<PageTitle>Command Stream | Smart-X</PageTitle>

<div class="commands-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">PART 2 / ADVANCED COLLECTIONS</span>
            <h1>Command Stream</h1>
            <p>Manage FIFO processing, priority scheduling, asynchronous critical alerts, and stack-based undo.</p>
        </div>
        <a class="back-link" href="/command-history">Command History →</a>
    </header>

    <section class="stats-grid" aria-label="Command statistics">
        <article class="stat-card">
            <span>Pending Commands</span>
            <strong>@CommandState.QueueCount</strong>
        </article>
        <article class="stat-card">
            <span>Critical Pending</span>
            <strong>@CommandState.CriticalQueueCount</strong>
        </article>
        <article class="stat-card">
            <span>Recorded Commands</span>
            <strong>@CommandState.HistoryCount</strong>
        </article>
        <article class="stat-card">
            <span>Active Errors</span>
            <strong>@CommandState.ActiveErrorCount</strong>
        </article>
    </section>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice" role="status">@_message</div>
    }

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Submit Command</h2>
                <p>Normal commands enter the managed collections. Critical alerts use a bounded asynchronous channel.</p>
            </div>
        </div>

        <form class="command-form"
              @onsubmit="SubmitCommand"
              @onsubmit:preventDefault>
            <div class="field">
                <label for="deviceId">Device ID</label>
                <input id="deviceId"
                       @bind="_deviceId"
                       required
                       maxlength="100"
                       placeholder="e.g. SENSOR-001" />
            </div>

            <div class="field">
                <label for="command">Command</label>
                <input id="command"
                       @bind="_command"
                       required
                       maxlength="200"
                       placeholder="e.g. ReadTemperature" />
            </div>

            <div class="field">
                <label for="priority">Priority</label>
                <select id="priority" @bind="_priority">
                    <option value="Normal">Normal</option>
                    <option value="High">High</option>
                    <option value="Critical">Critical</option>
                </select>
            </div>

            <div class="field">
                <label for="parameters">Parameters (optional)</label>
                <input id="parameters"
                       @bind="_parameters"
                       maxlength="1000"
                       placeholder="e.g. interval=5" />
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" type="submit">
                    Enqueue Command
                </button>
                <button class="btn btn-critical"
                        type="button"
                        @onclick="SubmitCriticalAlert"
                        disabled="@_submittingAlert">
                    @(_submittingAlert ? "Submitting Alert..." : "Ingest Critical Alert")
                </button>
            </div>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Queue Operations</h2>
                <p>Choose FIFO processing or priority-based scheduling.</p>
            </div>
            <span class="count-badge">@PendingCommands.Count pending</span>
        </div>

        <div class="operation-bar">
            <button class="btn btn-primary"
                    type="button"
                    @onclick="ProcessNext"
                    disabled="@(PendingCommands.Count == 0)">
                Process Next (FIFO)
            </button>

            <button class="btn btn-critical"
                    type="button"
                    @onclick="ProcessHighestPriority"
                    disabled="@(PendingCommands.Count == 0)">
                Process Highest Priority
            </button>

            <button class="btn btn-secondary"
                    type="button"
                    @onclick="UndoLast"
                    disabled="@(PendingCommands.Count == 0)">
                Undo Last (Stack)
            </button>

            <button class="btn btn-danger"
                    type="button"
                    @onclick="ClearQueue"
                    disabled="@(PendingCommands.Count == 0)">
                Clear Queue
            </button>
        </div>

        @if (PendingCommands.Count == 0)
        {
            <div class="empty-state">
                <strong>Queue is empty</strong>
                <p>Submit a command or ingest a critical alert to begin.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>FIFO Position</th>
                            <th>Device</th>
                            <th>Command</th>
                            <th>Priority</th>
                            <th>Submitted</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < PendingCommands.Count; i++)
                        {
                            var record = PendingCommands[i];

                            <tr @key="record.Id">
                                <td>@(i + 1)</td>
                                <td class="device">@record.DeviceId</td>
                                <td>@record.Command</td>
                                <td>
                                    <span class="priority @PriorityClass(record.Priority)">
                                        @record.Priority
                                    </span>
                                </td>
                                <td>@record.CreatedAt.ToLocalTime().ToString("HH:mm:ss.fff")</td>
                                <td>
                                    <span class="status status-queued">Queued</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Command Recommendations</h2>
                <p>Recommendations based on the current queue, history, and active errors.</p>
            </div>
        </div>

        @{
            var currentRecommendations = Recommendations.Generate();
        }

        @if (currentRecommendations.Count == 0)
        {
            <div class="empty-state">
                <strong>No recommendations</strong>
                <p>No command-related issues were identified from the current application state.</p>
            </div>
        }
        else
        {
            <div class="recommendation-list">
                @foreach (var item in currentRecommendations)
                {
                    <article class="recommendation-item" @key="item.Title + item.DeviceId">
                        <div class="recommendation-heading">
                            <strong>@item.Title</strong>
                            <span class="severity @SeverityClass(item.Severity)">
                                @item.Severity
                            </span>
                        </div>
                        <p>@item.Description</p>
                    </article>
                }
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Active Errors</h2>
                <p>Record and resolve error keys with duplicate prevention.</p>
            </div>
            <span class="count-badge">@CommandState.ActiveErrorCount active</span>
        </div>

        <form class="error-form"
              @onsubmit="RecordError"
              @onsubmit:preventDefault>
            <div class="field">
                <label for="errorKey">Error key</label>
                <input id="errorKey"
                       @bind="_errorKey"
                       maxlength="200"
                       required
                       placeholder="e.g. SENSOR-001:OFFLINE" />
            </div>
            <button class="btn btn-primary" type="submit">
                Record Error
            </button>
        </form>

        @if (ActiveErrors.Count == 0)
        {
            <div class="empty-state">
                <strong>No active errors</strong>
            </div>
        }
        else
        {
            <ul class="error-list">
                @foreach (var error in ActiveErrors.OrderBy(x => x))
                {
                    <li @key="error">
                        <code>@error</code>
                        <button class="btn btn-secondary"
                                type="button"
                                @onclick="() => ResolveError(error)">
                            Resolve
                        </button>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Recent Command History</h2>
                <p>Latest command state transitions.</p>
            </div>
            <a class="back-link" href="/command-history">Full History &amp; Audit →</a>
        </div>

        @if (RecentHistory.Count == 0)
        {
            <div class="empty-state">
                <strong>No command history yet</strong>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Command</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in RecentHistory)
                        {
                            <tr @key="record.Id">
                                <td class="device">@record.DeviceId</td>
                                <td>@record.Command</td>
                                <td>
                                    <span class="priority @PriorityClass(record.Priority)">
                                        @record.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="status @StatusClass(record.Status)">
                                        @record.Status
                                    </span>
                                </td>
                                <td class="details">@record.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <p class="disclaimer">
        Processing updates local application state only. No physical device operation is executed.
        Command state and audit records are held in memory for the current server-side application circuit.
    </p>
</div>

@code {
    private string _deviceId = string.Empty;
    private string _command = string.Empty;
    private string _priority = "Normal";
    private string _parameters = string.Empty;
    private string _errorKey = string.Empty;
    private string _message = string.Empty;
    private bool _submittingAlert;

    private IReadOnlyList<CommandRecord> PendingCommands =>
        CommandState.Queue.ToArray();

    private IReadOnlyList<CommandRecord> RecentHistory =>
        CommandState.History.Take(10).ToArray();

    private IReadOnlyCollection<string> ActiveErrors =>
        CommandState.ActiveErrors;

    protected override void OnInitialized()
    {
        CommandState.StateChanged += HandleStateChanged;
    }

    private void SubmitCommand()
    {
        try
        {
            var record = CommandState.Enqueue(
                _deviceId,
                _command,
                _priority,
                _parameters);

            _message =
                $"{record.Priority} command '{record.Command}' queued for {record.DeviceId}.";

            _deviceId = string.Empty;
            _command = string.Empty;
            _parameters = string.Empty;
            _priority = "Normal";
        }
        catch (ArgumentException ex)
        {
            _message = ex.Message;
        }
    }

    private async Task SubmitCriticalAlert()
    {
        if (_submittingAlert)
        {
            return;
        }

        var deviceId = _deviceId.Trim();
        var command = _command.Trim();

        if (string.IsNullOrWhiteSpace(deviceId) ||
            string.IsNullOrWhiteSpace(command))
        {
            _message =
                "Enter a device ID and alert command before ingesting a critical alert.";
            return;
        }

        _submittingAlert = true;

        try
        {
            await AlertStream.SubmitAsync(
                deviceId,
                command,
                _parameters);

            _message =
                $"Critical alert accepted into the ingestion stream for {deviceId}.";

            _deviceId = string.Empty;
            _command = string.Empty;
            _parameters = string.Empty;
            _priority = "Normal";
        }
        catch (ArgumentException ex)
        {
            _message = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _message = $"Critical-alert stream unavailable: {ex.Message}";
        }
        finally
        {
            _submittingAlert = false;
        }
    }

    private void ProcessNext()
    {
        var record = CommandState.ProcessNext();

        _message = record is null
            ? "No pending commands to process."
            : $"FIFO processed '{record.Command}' for {record.DeviceId}.";
    }

    private void ProcessHighestPriority()
    {
        var record = CommandState.ProcessHighestPriority();

        _message = record is null
            ? "No pending commands to process."
            : $"Priority scheduler processed {record.Priority} command '{record.Command}' for {record.DeviceId}.";
    }

    private void UndoLast()
    {
        var record = CommandState.UndoLast();

        _message = record is null
            ? "No pending command is available to undo."
            : $"Undid pending command '{record.Command}' for {record.DeviceId}.";
    }

    private void ClearQueue()
    {
        var count = CommandState.ClearQueue();
        _message = $"Cleared {count} pending command(s).";
    }

    private void RecordError()
    {
        if (string.IsNullOrWhiteSpace(_errorKey))
        {
            _message = "Enter an error key.";
            return;
        }

        var key = _errorKey.Trim();
        var existed = ActiveErrors.Contains(
            key,
            StringComparer.OrdinalIgnoreCase);

        CommandState.RecordActiveError(key);

        _message = existed
            ? $"Error '{key}' is already active."
            : $"Recorded active error '{key}'.";

        _errorKey = string.Empty;
    }

    private void ResolveError(string error)
    {
        var resolved = CommandState.ResolveActiveError(error);

        _message = resolved
            ? $"Resolved error '{error}'."
            : $"Error '{error}' was not active.";
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string PriorityClass(string priority) =>
        priority.ToLowerInvariant() switch
        {
            "critical" => "priority-critical",
            "high" => "priority-high",
            _ => "priority-normal"
        };

    private static string StatusClass(string status) =>
        status.ToLowerInvariant() switch
        {
            "queued" => "status-queued",
            "processed locally" => "status-processed",
            "undone" => "status-undone",
            "cleared" => "status-cleared",
            _ => "status-queued"
        };

    private static string SeverityClass(
        RecommendationSeverity severity) =>
        severity switch
        {
            RecommendationSeverity.Critical => "severity-critical",
            RecommendationSeverity.Warning => "severity-warning",
            _ => "severity-info"
        };

    public void Dispose()
    {
        CommandState.StateChanged -= HandleStateChanged;
    }
}
