```razor
@page "/commands"
@using System.Linq
@implements IDisposable
@inject SmartX.Web.Services.CommandStateService CommandState
@inject SmartX.Web.Services.RecommendationEngine RecommendationEngine

<PageTitle>Command Stream | Smart-X</PageTitle>

<div class="commands-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">PART 2 / COMMAND MANAGEMENT</span>
            <h1>Real-Time Command Stream</h1>
            <p>Issue commands, review audit history, and monitor predictive recommendations.</p>
        </div>
        <span class="session-badge"><span class="status-dot"></span> Session Active</span>
    </header>

    <section class="stats-grid">
        <article class="stat-card">
            <span>Total Commands</span>
            <strong>@CommandState.HistoryCount</strong>
            <small>Recorded this session</small>
        </article>
        <article class="stat-card">
            <span>Queued Commands</span>
            <strong>@CommandState.QueueCount</strong>
            <small>Awaiting processing</small>
        </article>
        <article class="stat-card">
            <span>Active Errors</span>
            <strong>@CommandState.ActiveErrors.Count</strong>
            <small>Unique unresolved error keys</small>
        </article>
        <article class="stat-card">
            <span>Audit Events</span>
            <strong>@CommandState.AuditLog.Count</strong>
            <small>Chronologically recorded</small>
        </article>
    </section>

    <section class="panel recommendations-panel">
        <div class="panel-heading">
            <div>
                <h2>Predictive Recommendations</h2>
                <p>Insights derived from command activity and search terms.</p>
            </div>
            <span class="count-badge">@Recommendations.Count insights</span>
        </div>

        @if (Recommendations.Count == 0)
        {
            <div class="empty-state">
                <strong>No recommendations currently available</strong>
                <p>Recommendations appear when relevant activity or search terms are present.</p>
            </div>
        }
        else
        {
            <div class="recommendation-list">
                @foreach (var recommendation in Recommendations)
                {
                    <article class="recommendation-card"
                             @key="RecommendationKey(recommendation)">
                        <div class="recommendation-card-heading">
                            <h3>@recommendation.Title</h3>
                            <span class="severity @SeverityClass(recommendation.Severity)">
                                @SeverityLabel(recommendation.Severity)
                            </span>
                        </div>
                        <p>@recommendation.Description</p>
                        @if (!string.IsNullOrWhiteSpace(recommendation.DeviceId))
                        {
                            <small>Device: @recommendation.DeviceId</small>
                        }
                    </article>
                }
            </div>
        }

        <div class="recommendation-search">
            <label for="recommendationSearch">Search for guidance</label>
            <div class="search-row">
                <input id="recommendationSearch"
                       @bind="_searchQuery"
                       @bind:event="oninput"
                       maxlength="120"
                       placeholder="e.g. offline devices, battery, failed commands" />
                <button type="button"
                        class="secondary-button"
                        @onclick="RefreshRecommendations">
                    Analyse
                </button>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Issue Command</h2>
                <p>Submit a command to the in-memory command queue.</p>
            </div>
            <span class="panel-tag">COMMAND CONSOLE</span>
        </div>

        <form class="command-form"
              @onsubmit="SubmitCommandAsync"
              @onsubmit:preventDefault>
            <div class="form-grid">
                <div class="form-field">
                    <label for="deviceId">Device / Sensor ID</label>
                    <input id="deviceId"
                           @bind="_deviceId"
                           maxlength="64"
                           required
                           placeholder="e.g. SENSOR-001" />
                </div>

                <div class="form-field">
                    <label for="commandType">Command</label>
                    <select id="commandType" @bind="_selectedCommand">
                        <option value="RequestTelemetry">Request telemetry</option>
                        <option value="RestartDevice">Restart device</option>
                        <option value="SetSamplingInterval">Set sampling interval</option>
                        <option value="RunDiagnostics">Run diagnostics</option>
                        <option value="DisconnectDevice">Disconnect device</option>
                    </select>
                </div>

                <div class="form-field">
                    <label for="priority">Priority</label>
                    <select id="priority" @bind="_selectedPriority">
                        <option value="Normal">Normal</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>
                    </select>
                </div>
            </div>

            <div class="form-field parameter-field">
                <label for="parameters">Parameters (optional)</label>
                <input id="parameters"
                       @bind="_parameters"
                       maxlength="256"
                       placeholder="e.g. interval=30" />
            </div>

            <div class="actions">
                <button type="submit" class="primary-button">+ Queue Command</button>
                <button type="button"
                        class="secondary-button"
                        @onclick="UndoLast"
                        disabled="@(!CommandState.History.Any(x => x.Status == "Queued"))">
                    Undo Last
                </button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(_feedback))
        {
            <div class="feedback @(_isError ? "error" : "success")" role="status">
                @_feedback
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Command Queue</h2>
                <p>Choose FIFO processing or process the highest-priority pending command.</p>
            </div>
            <span class="count-badge">@CommandState.QueueCount queued</span>
        </div>

        @if (CommandState.Queue.Count == 0)
        {
            <div class="empty-state">
                <strong>No commands queued</strong>
                <p>Submitted commands will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Command</th>
                            <th>Priority</th>
                            <th>Queued At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in CommandState.Queue)
                        {
                            <tr @key="item.Id">
                                <td class="device">@item.DeviceId</td>
                                <td>@item.Command</td>
                                <td>
                                    <span class="priority @PriorityClass(item.Priority)">
                                        @item.Priority
                                    </span>
                                </td>
                                <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="actions queue-actions">
                <button type="button"
                        class="secondary-button"
                        @onclick="ProcessNext">
                    Process Next (FIFO)
                </button>
                <button type="button"
                        class="primary-button"
                        @onclick="ProcessHighestPriority">
                    Process Highest Priority
                </button>
                <button type="button"
                        class="text-button"
                        @onclick="ClearQueue">
                    Clear Queue
                </button>
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Active Error Registry</h2>
                <p>Track unique unresolved error keys using a HashSet.</p>
            </div>
            <span class="count-badge">@CommandState.ActiveErrors.Count active</span>
        </div>

        <div class="error-entry">
            <label for="errorKey">Error key</label>
            <div class="search-row">
                <input id="errorKey"
                       @bind="_errorKey"
                       @bind:event="oninput"
                       maxlength="160"
                       placeholder="e.g. SENSOR-001:OFFLINE" />
                <button type="button"
                        class="secondary-button"
                        @onclick="RecordError">
                    Record Error
                </button>
            </div>
        </div>

        @if (CommandState.ActiveErrors.Count == 0)
        {
            <div class="empty-state">
                <strong>No active errors recorded</strong>
                <p>Record an error key to track it until resolved.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Error Key</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var error in CommandState.ActiveErrors.OrderBy(x => x))
                        {
                            <tr @key="error">
                                <td class="device">@error</td>
                                <td>
                                    <button type="button"
                                            class="secondary-button"
                                            @onclick="() => ResolveError(error)">
                                        Resolve
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Command History</h2>
                <p>Recorded submissions and local processing statuses.</p>
            </div>
            <span class="count-badge">@CommandState.HistoryCount records</span>
        </div>

        @if (CommandState.History.Count == 0)
        {
            <div class="empty-state">
                <strong>No command history yet</strong>
                <p>Your command records will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Device</th>
                            <th>Command</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in CommandState.History)
                        {
                            <tr @key="item.Id">
                                <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="device">@item.DeviceId</td>
                                <td>@item.Command</td>
                                <td>
                                    <span class="priority @PriorityClass(item.Priority)">
                                        @item.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="history-status @StatusClass(item.Status)">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="details">@item.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h2>Chronological Audit Log</h2>
                <p>Queue operations, processing, undo, clearing, and error changes.</p>
            </div>
            <span class="count-badge">@CommandState.AuditLog.Count events</span>
        </div>

        @if (CommandState.AuditLog.Count == 0)
        {
            <div class="empty-state">
                <strong>No audit events yet</strong>
                <p>Events will appear as commands and errors are managed.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Action</th>
                            <th>Device</th>
                            <th>Command</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in CommandState.AuditLog.Reverse())
                        {
                            <tr @key="entry">
                                <td>@entry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                                <td>@entry.Action</td>
                                <td class="device">@DisplayOrDash(entry.DeviceId)</td>
                                <td>@DisplayOrDash(entry.Command)</td>
                                <td class="details">@entry.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <p class="disclaimer">
        Commands are stored in the current Blazor circuit and are not sent to physical devices.
        The audit log is in memory and is not persisted to a database. Telemetry-based recommendations
        require actual telemetry observations.
    </p>
</div>

