@page "/commands"
@using System
@using System.Linq
@using System.Threading.Tasks
@using SmartX.Web.Services
@implements IDisposable
@inject CommandStateService CommandState
@inject RecommendationEngine Recommendations
@inject CriticalAlertStreamService AlertStream

<PageTitle>Command Stream | Smart-X</PageTitle>

<div class="commands-page">
    <header class="commands-heading">
        <div class="commands-heading-copy">
            <div class="commands-breadcrumb">
                <span class="breadcrumb-root">SMART-X</span>
                <span class="breadcrumb-separator">/</span>
                <span>COMMAND MANAGEMENT</span>
            </div>

            <div class="commands-title-row">
                <div class="commands-title-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M5 7h14M5 12h9M5 17h6"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round" />
                        <circle cx="18" cy="17" r="2.5"
                                stroke="currentColor"
                                stroke-width="1.8" />
                    </svg>
                </div>

                <div>
                    <span class="commands-eyebrow">PART 2 / ADVANCED COLLECTIONS</span>
                    <h1>Command Stream</h1>
                </div>
            </div>

            <p class="commands-description">
                Manage command queues, priority scheduling, asynchronous critical alerts,
                and stack-based undo from one operational workspace.
            </p>
        </div>

        <a class="commands-header-link" href="/command-history">
            <span>View command history</span>
            <span aria-hidden="true">→</span>
        </a>
    </header>

    <section class="commands-stats" aria-label="Command statistics">
        <article class="commands-stat-card">
            <div class="stat-topline">
                <span class="stat-label">Pending commands</span>
                <span class="stat-icon stat-icon-blue" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M5 6.5h14M5 12h14M5 17.5h9"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round" />
                    </svg>
                </span>
            </div>
            <strong class="stat-value">@CommandState.QueueCount</strong>
            <span class="stat-caption">Awaiting processing</span>
        </article>

        <article class="commands-stat-card">
            <div class="stat-topline">
                <span class="stat-label">Critical pending</span>
                <span class="stat-icon stat-icon-red" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M12 3.5 21 20H3L12 3.5Z"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linejoin="round" />
                        <path d="M12 9v4.5m0 3h.01"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round" />
                    </svg>
                </span>
            </div>
            <strong class="stat-value">@CommandState.CriticalQueueCount</strong>
            <span class="stat-caption">High-urgency workload</span>
        </article>

        <article class="commands-stat-card">
            <div class="stat-topline">
                <span class="stat-label">Recorded commands</span>
                <span class="stat-icon stat-icon-violet" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M6 4.5h9l4 4v11H6v-15Z"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linejoin="round" />
                        <path d="M14.5 4.5v4h4M9 13h7M9 16.5h7"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>
                </span>
            </div>
            <strong class="stat-value">@CommandState.HistoryCount</strong>
            <span class="stat-caption">Available audit records</span>
        </article>

        <article class="commands-stat-card">
            <div class="stat-topline">
                <span class="stat-label">Active errors</span>
                <span class="stat-icon stat-icon-amber" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M12 4v9m0 4h.01"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round" />
                        <circle cx="12" cy="12" r="9"
                                stroke="currentColor"
                                stroke-width="1.8" />
                    </svg>
                </span>
            </div>
            <strong class="stat-value">@CommandState.ActiveErrorCount</strong>
            <span class="stat-caption">Requiring attention</span>
        </article>
    </section>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="commands-notice" role="status" aria-live="polite">
            <span class="notice-indicator" aria-hidden="true"></span>
            <span class="notice-message">@_message</span>
            <button class="notice-dismiss"
                    type="button"
                    aria-label="Dismiss notification"
                    @onclick="DismissMessage">
                ×
            </button>
        </div>
    }

    <section class="commands-panel">
        <div class="panel-heading">
            <div class="panel-heading-copy">
                <span class="panel-kicker">COMMAND INPUT</span>
                <h2>Submit command</h2>
                <p>Configure the target device, command payload, and processing priority.</p>
            </div>
            <span class="panel-index">01</span>
        </div>

        <form class="command-form"
              @onsubmit="SubmitCommand"
              @onsubmit:preventDefault>
            <div class="form-fields">
                <div class="commands-field">
                    <label for="deviceId">Device ID <span class="required-mark">*</span></label>
                    <input id="deviceId"
                           @bind="_deviceId"
                           required
                           maxlength="100"
                           autocomplete="off"
                           placeholder="e.g. SENSOR-001" />
                    <small>Identifier of the target device</small>
                </div>

                <div class="commands-field">
                    <label for="command">Command <span class="required-mark">*</span></label>
                    <input id="command"
                           @bind="_command"
                           required
                           maxlength="200"
                           autocomplete="off"
                           placeholder="e.g. ReadTemperature" />
                    <small>Operation to enqueue or send as an alert</small>
                </div>

                <div class="commands-field">
                    <label for="priority">Processing priority</label>
                    <select id="priority" @bind="_priority">
                        <option value="Normal">Normal</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>
                    </select>
                    <small>Used by priority-based scheduling</small>
                </div>

                <div class="commands-field">
                    <label for="parameters">Parameters <span class="optional-mark">Optional</span></label>
                    <input id="parameters"
                           @bind="_parameters"
                           maxlength="1000"
                           autocomplete="off"
                           placeholder="e.g. interval=5" />
                    <small>Additional command arguments</small>
                </div>
            </div>

            <div class="form-footer">
                <p class="form-helper">
                    <span class="required-mark">*</span>
                    Required fields
                </p>

                <div class="form-actions">
                    <button class="commands-btn commands-btn-primary" type="submit">
                        <span aria-hidden="true">+</span>
                        Enqueue command
                    </button>

                    <button class="commands-btn commands-btn-critical"
                            type="button"
                            @onclick="SubmitCriticalAlert"
                            disabled="@_submittingAlert">
                        @if (_submittingAlert)
                        {
                            <span class="button-spinner" aria-hidden="true"></span>
                            <span>Submitting alert…</span>
                        }
                        else
                        {
                            <span class="button-alert-icon" aria-hidden="true">!</span>
                            <span>Ingest critical alert</span>
                        }
                    </button>
                </div>
            </div>
        </form>
    </section>

    <section class="commands-panel">
        <div class="panel-heading panel-heading-queue">
            <div class="panel-heading-copy">
                <span class="panel-kicker">PROCESSING CONTROL</span>
                <h2>Queue operations</h2>
                <p>Process commands in FIFO order, schedule by priority, or undo pending work.</p>
            </div>

            <div class="panel-heading-metric">
                <strong>@PendingCommands.Count</strong>
                <span>pending</span>
            </div>
        </div>

        <div class="queue-toolbar">
            <div class="toolbar-group">
                <button class="commands-btn commands-btn-primary"
                        type="button"
                        @onclick="ProcessNext"
                        disabled="@(PendingCommands.Count == 0)">
                    <span class="toolbar-button-icon" aria-hidden="true">→</span>
                    Process next
                    <span class="button-mode">FIFO</span>
                </button>

                <button class="commands-btn commands-btn-outline"
                        type="button"
                        @onclick="ProcessHighestPriority"
                        disabled="@(PendingCommands.Count == 0)">
                    <span class="toolbar-button-icon" aria-hidden="true">↑</span>
                    Highest priority
                </button>
            </div>

            <div class="toolbar-group toolbar-group-secondary">
                <button class="commands-btn commands-btn-neutral"
                        type="button"
                        @onclick="UndoLast"
                        disabled="@(PendingCommands.Count == 0)">
                    Undo last
                </button>

                <button class="commands-btn commands-btn-danger-outline"
                        type="button"
                        @onclick="ClearQueue"
                        disabled="@(PendingCommands.Count == 0)">
                    Clear queue
                </button>
            </div>
        </div>

        @if (PendingCommands.Count == 0)
        {
            <div class="commands-empty-state">
                <span class="empty-state-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M5 6.5h14M5 12h14M5 17.5h9"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round" />
                    </svg>
                </span>
                <strong>Queue is empty</strong>
                <p>New commands will appear here when they are enqueued.</p>
            </div>
        }
        else
        {
            <div class="commands-table-wrap">
                <table class="commands-table">
                    <thead>
                        <tr>
                            <th class="column-position">Position</th>
                            <th>Device</th>
                            <th>Command</th>
                            <th>Priority</th>
                            <th>Submitted</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < PendingCommands.Count; i++)
                        {
                            var record = PendingCommands[i];

                            <tr @key="record.Id">
                                <td>
                                    <span class="position-number">@(i + 1)</span>
                                </td>
                                <td class="device-cell">@record.DeviceId</td>
                                <td class="command-cell">@record.Command</td>
                                <td>
                                    <span class="priority-badge @PriorityClass(record.Priority)">
                                        <span class="badge-dot" aria-hidden="true"></span>
                                        @record.Priority
                                    </span>
                                </td>
                                <td class="timestamp-cell">
                                    @record.CreatedAt.ToLocalTime().ToString("HH:mm:ss.fff")
                                </td>
                                <td>
                                    <span class="command-status status-queued">
                                        <span class="badge-dot" aria-hidden="true"></span>
                                        Queued
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-footer">
                <span>Showing all @PendingCommands.Count pending command(s)</span>
                <span>Queue order <strong>FIFO</strong></span>
            </div>
        }
    </section>

    @{
        var currentRecommendations = Recommendations.Generate();
    }

    <section class="commands-panel">
        <div class="panel-heading">
            <div class="panel-heading-copy">
                <span class="panel-kicker">INTELLIGENCE</span>
                <h2>Command recommendations</h2>
                <p>Insights generated from the current queue, command history, and active errors.</p>
            </div>

            <span class="recommendation-count">
                @currentRecommendations.Count
                @(currentRecommendations.Count == 1 ? "insight" : "insights")
            </span>
        </div>

        @if (currentRecommendations.Count == 0)
        {
            <div class="commands-empty-state commands-empty-compact">
                <strong>No recommendations</strong>
                <p>No command-related issues were identified from the current application state.</p>
            </div>
        }
        else
        {
            <div class="recommendation-list">
                @foreach (var item in currentRecommendations)
                {
                    <article class="recommendation-item" @key="item.Title + item.DeviceId">
                        <div class="recommendation-severity-marker @SeverityClass(item.Severity)"
                             aria-hidden="true"></div>

                        <div class="recommendation-content">
                            <div class="recommendation-heading">
                                <h3>@item.Title</h3>
                                <span class="severity-badge @SeverityClass(item.Severity)">
                                    @item.Severity
                                </span>
                            </div>
                            <p>@item.Description</p>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="commands-panel">
        <div class="panel-heading">
            <div class="panel-heading-copy">
                <span class="panel-kicker">SYSTEM HEALTH</span>
                <h2>Active errors</h2>
                <p>Track active error keys, prevent duplicates, and resolve issues as they are addressed.</p>
            </div>

            <div class="panel-heading-metric panel-heading-metric-alert">
                <strong>@CommandState.ActiveErrorCount</strong>
                <span>active</span>
            </div>
        </div>

        <form class="error-form"
              @onsubmit="RecordError"
              @onsubmit:preventDefault>
            <div class="commands-field error-key-field">
                <label for="errorKey">Error key</label>
                <input id="errorKey"
                       @bind="_errorKey"
                       maxlength="200"
                       required
                       autocomplete="off"
                       placeholder="e.g. SENSOR-001:OFFLINE" />
            </div>

            <button class="commands-btn commands-btn-primary error-submit-btn"
                    type="submit">
                Record error
            </button>
        </form>

        @if (ActiveErrors.Count == 0)
        {
            <div class="commands-empty-state commands-empty-compact">
                <strong>No active errors</strong>
                <p>There are currently no active error keys to resolve.</p>
            </div>
        }
        else
        {
            <ul class="error-list">
                @foreach (var error in ActiveErrors.OrderBy(x => x))
                {
                    <li @key="error">
                        <div class="error-key-content">
                            <span class="error-key-indicator" aria-hidden="true"></span>
                            <code>@error</code>
                        </div>
                        <button class="commands-btn commands-btn-neutral commands-btn-small"
                                type="button"
                                @onclick="() => ResolveError(error)">
                            Resolve
                        </button>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="commands-panel">
        <div class="panel-heading">
            <div class="panel-heading-copy">
                <span class="panel-kicker">AUDIT TRAIL</span>
                <h2>Recent command history</h2>
                <p>The latest command state transitions recorded by the application.</p>
            </div>

            <a class="panel-heading-link" href="/command-history">
                Full history <span aria-hidden="true">→</span>
            </a>
        </div>

        @if (RecentHistory.Count == 0)
        {
            <div class="commands-empty-state commands-empty-compact">
                <strong>No command history yet</strong>
                <p>Processed commands and other state transitions will be listed here.</p>
            </div>
        }
        else
        {
            <div class="commands-table-wrap">
                <table class="commands-table">
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Command</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in RecentHistory)
                        {
                            <tr @key="record.Id">
                                <td class="device-cell">@record.DeviceId</td>
                                <td class="command-cell">@record.Command</td>
                                <td>
                                    <span class="priority-badge @PriorityClass(record.Priority)">
                                        <span class="badge-dot" aria-hidden="true"></span>
                                        @record.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="command-status @StatusClass(record.Status)">
                                        <span class="badge-dot" aria-hidden="true"></span>
                                        @record.Status
                                    </span>
                                </td>
                                <td class="details-cell">@record.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-footer">
                <span>Latest @RecentHistory.Count record(s)</span>
                <a href="/command-history">View complete audit trail →</a>
            </div>
        }
    </section>

    <footer class="commands-disclaimer">
        <span class="disclaimer-icon" aria-hidden="true">i</span>
        <p>
            <strong>Operational note</strong>
            Processing updates local application state only. No physical device operation is executed.
            Command state and audit records are held in memory for the current server-side application circuit.
        </p>
    </footer>
</div>

<style>
    .commands-page {
        --cmd-text: #19263b;
        --cmd-muted: #718096;
        --cmd-subtle: #93a0b2;
        --cmd-border: #e5eaf2;
        --cmd-border-strong: #d8e0ec;
        --cmd-surface: #fff;
        --cmd-background: #f5f7fb;
        --cmd-primary: #316fe5;
        --cmd-primary-hover: #245ac4;
        --cmd-green: #16865e;
        --cmd-red: #c83f4d;
        --cmd-amber: #a86613;
        --cmd-violet: #7251c7;
        width: 100%;
        max-width: 1500px;
        min-width: 0;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 22px;
        color: var(--cmd-text);
        font-family: Inter, "Segoe UI", Arial, sans-serif;
        font-size: 13px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
    }

        .commands-page *,
        .commands-page *::before,
        .commands-page *::after {
            box-sizing: border-box;
        }

    .commands-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        padding: 4px 0 3px;
    }

    .commands-heading-copy {
        min-width: 0;
    }

    .commands-breadcrumb {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 15px;
        color: #8491a4;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.15px;
    }

    .breadcrumb-root {
        color: #3d69b8;
    }

    .breadcrumb-separator {
        color: #bdc7d5;
    }

    .commands-title-row {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .commands-title-icon {
        width: 49px;
        height: 49px;
        flex: 0 0 49px;
        display: grid;
        place-items: center;
        color: #326bd3;
        background: #e8efff;
        border: 1px solid #dce7ff;
        border-radius: 13px;
    }

        .commands-title-icon svg {
            width: 25px;
            height: 25px;
        }

    .commands-eyebrow {
        display: block;
        margin-bottom: 4px;
        color: #71819a;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.15px;
    }

    .commands-heading h1 {
        margin: 0;
        color: #16243a;
        font-size: clamp(25px, 2.3vw, 32px);
        font-weight: 780;
        line-height: 1.2;
        letter-spacing: -1.05px;
    }

    .commands-description {
        max-width: 760px;
        margin: 13px 0 0;
        color: #6d7b90;
        font-size: 12px;
        line-height: 1.75;
    }

    .commands-header-link,
    .panel-heading-link {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 11px;
        min-height: 38px;
        padding: 0 13px;
        border: 1px solid #dce4f0;
        border-radius: 8px;
        color: #375a92;
        background: #fff;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        transition: background .16s ease, border-color .16s ease;
    }

        .commands-header-link:hover,
        .panel-heading-link:hover {
            color: #244f9c;
            background: #f4f7fd;
            border-color: #c8d7ef;
        }

        .commands-header-link:focus-visible,
        .panel-heading-link:focus-visible {
            outline: 2px solid #80aaff;
            outline-offset: 3px;
        }

    .commands-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .commands-stat-card {
        min-width: 0;
        min-height: 126px;
        padding: 18px 19px 16px;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        background: #fff;
        border: 1px solid var(--cmd-border);
        border-radius: 12px;
        box-shadow: 0 2px 5px rgb(26 43 70 / 2%);
    }

    .stat-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .stat-label {
        color: #68778d;
        font-size: 11px;
        font-weight: 650;
        line-height: 1.4;
    }

    .stat-icon {
        width: 33px;
        height: 33px;
        flex: 0 0 33px;
        display: grid;
        place-items: center;
        border-radius: 9px;
    }

        .stat-icon svg {
            width: 18px;
            height: 18px;
        }

    .stat-icon-blue {
        color: #326bd3;
        background: #edf3ff;
    }

    .stat-icon-red {
        color: #c43f4a;
        background: #fff0f0;
    }

    .stat-icon-violet {
        color: #7251c7;
        background: #f2edff;
    }

    .stat-icon-amber {
        color: #a96a14;
        background: #fff5e6;
    }

    .stat-value {
        margin-top: 8px;
        color: #17253a;
        font-size: 29px;
        font-weight: 780;
        line-height: 1.1;
        letter-spacing: -.8px;
        font-variant-numeric: tabular-nums;
    }

    .stat-caption {
        margin-top: 6px;
        color: #95a0b0;
        font-size: 10px;
        line-height: 1.4;
    }

    .commands-notice {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 12px 14px;
        color: #31588e;
        background: #edf4ff;
        border: 1px solid #d6e5ff;
        border-radius: 9px;
        font-size: 12px;
        line-height: 1.5;
    }

    .notice-indicator {
        width: 7px;
        height: 7px;
        flex: 0 0 7px;
        border-radius: 50%;
        background: #3978ed;
    }

    .notice-message {
        flex: 1;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .notice-dismiss {
        width: 25px;
        height: 25px;
        flex: 0 0 25px;
        display: grid;
        place-items: center;
        border: 0;
        border-radius: 6px;
        color: #55739f;
        background: transparent;
        font-size: 19px;
        line-height: 1;
        cursor: pointer;
    }

        .notice-dismiss:hover {
            background: #dce9ff;
        }

    .commands-panel {
        min-width: 0;
        overflow: hidden;
        background: var(--cmd-surface);
        border: 1px solid var(--cmd-border);
        border-radius: 12px;
        box-shadow: 0 2px 5px rgb(26 43 70 / 2%);
    }

    .panel-heading {
        min-height: 98px;
        padding: 21px 23px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid #edf0f5;
    }

    .panel-heading-copy {
        min-width: 0;
    }

    .panel-kicker {
        display: block;
        margin-bottom: 5px;
        color: #8190a6;
        font-size: 9px;
        font-weight: 800;
