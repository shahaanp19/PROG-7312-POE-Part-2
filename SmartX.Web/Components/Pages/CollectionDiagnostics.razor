@page "/collection-diagnostics"
@using System
@using System.Linq
@using SmartX.Web.Services

<PageTitle>Collection Diagnostics | Smart-X</PageTitle>

<div class="diagnostics-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">PART 2 / ADVANCED COLLECTIONS</span>
            <h1>Collection &amp; Lookup Diagnostics</h1>
            <p>
                Validate unique command tracking, pending-command membership,
                duplicate-error prevention, dictionary lookups, sorted timelines,
                priority scheduling, FIFO processing, and LIFO undo.
            </p>
        </div>
        <a class="back-link" href="/commands">← Command Stream</a>
    </header>

    <section class="summary-grid">
        <article class="summary-card">
            <span>Tests Executed</span>
            <strong>@_results.Count</strong>
        </article>
        <article class="summary-card">
            <span>Passed</span>
            <strong class="passed">@_results.Count(result => result.Passed)</strong>
        </article>
        <article class="summary-card">
            <span>Failed</span>
            <strong class="failed">@_results.Count(result => !result.Passed)</strong>
        </article>
        <article class="summary-card">
            <span>Overall Status</span>
            <strong class="@(_hasRun ? (_allPassed ? "passed" : "failed") : "")">
                @(_hasRun ? (_allPassed ? "PASS" : "FAIL") : "NOT RUN")
            </strong>
        </article>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>Automated Collection Tests</h2>
            <p>
                Tests execute against isolated CommandStateService instances
                without modifying the live command queue.
            </p>
        </div>

        <div class="actions">
            <button type="button"
                    class="btn btn-primary"
                    @onclick="RunDiagnostics">
                Run All Diagnostics
            </button>
            <button type="button"
                    class="btn btn-secondary"
                    @onclick="ClearResults"
                    disabled="@(!_hasRun)">
                Clear Results
            </button>
        </div>

        @if (!_hasRun)
        {
            <div class="empty-state">
                <strong>Diagnostics have not been run</strong>
                <p>
                    Run the automated checks to verify unique tracking,
                    collection consistency, and indexed lookup operations.
                </p>
            </div>
        }
        else if (_results.Count == 0)
        {
            <div class="empty-state">
                <strong>No diagnostic results returned</strong>
                <p>Run the diagnostics again to produce results.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Test</th>
                            <th>Result</th>
                            <th>Verification Details</th>
                            <th>Elapsed (ms)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in _results)
                        {
                            <tr @key="result.Name">
                                <td class="test-name">@result.Name</td>
                                <td>
                                    <span class="result-badge @(result.Passed ? "result-pass" : "result-fail")">
                                        @(result.Passed ? "PASS" : "FAIL")
                                    </span>
                                </td>
                                <td class="details">@result.Details</td>
                                <td class="elapsed">@result.ElapsedMilliseconds</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="result-summary @(_allPassed ? "summary-pass" : "summary-fail")"
                 role="status">
                @if (_allPassed)
                {
                    <strong>All collection diagnostics passed.</strong>
                    <p>
                        Every executed check passed. Review the results for
                        set membership, duplicate prevention, lookup efficiency,
                        timeline ordering, and workload evidence.
                    </p>
                }
                else
                {
                    <strong>One or more diagnostics failed.</strong>
                    <p>
                        Inspect the failed test details and correct the
                        underlying collection behavior.
                    </p>
                }
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>Unique Collections: Sets</h2>
            <p>
                Hash-based membership tracking prevents duplicate entries
                and supports efficient uniqueness and membership checks.
            </p>
        </div>

        <div class="evidence-grid">
            <article class="evidence-card">
                <span class="evidence-icon">01</span>
                <h3>Unique Command Tracking</h3>
                <p>
                    Tracks command identifiers in a HashSet so each command
                    ID is recorded once. Historical IDs remain tracked after
                    commands are processed or the pending queue is cleared.
                </p>
                <code>HashSet&lt;Guid&gt; _knownCommandIds</code>
            </article>

            <article class="evidence-card">
                <span class="evidence-icon">02</span>
                <h3>Pending Command Membership</h3>
                <p>
                    Maintains a separate set of pending command IDs. Processing,
                    undo, and queue clearing update membership without requiring
                    a full scan of the pending queue.
                </p>
                <code>HashSet&lt;Guid&gt; _pendingIds</code>
            </article>

            <article class="evidence-card">
                <span class="evidence-icon">03</span>
                <h3>Duplicate Active-Error Prevention</h3>
                <p>
                    Uses case-insensitive membership to avoid storing duplicate
                    active error messages with different letter casing.
                    Resolved errors can be removed from the set.
                </p>
                <code>HashSet&lt;string&gt; _activeErrors</code>
            </article>

            <article class="evidence-card">
                <span class="evidence-icon">04</span>
                <h3>Set Consistency Diagnostics</h3>
                <p>
                    Automated checks validate unique command counts,
                    pending-state transitions, case-insensitive error
                    deduplication, and set membership after queue clearing.
                </p>
                <code>CommandCollectionDiagnostics.RunAll()</code>
            </article>
        </div>

        <div class="set-complexity">
            <h3>Expected Set Operation Costs</h3>
            <div class="complexity-grid">
                <div>
                    <strong>Average O(1)</strong>
                    <span>Add an item</span>
                </div>
                <div>
                    <strong>Average O(1)</strong>
                    <span>Check membership</span>
                </div>
                <div>
                    <strong>Average O(1)</strong>
                    <span>Remove an item</span>
                </div>
            </div>
            <p>
                These are expected average-case costs for hash-based sets,
                not worst-case guarantees. Performance depends on hashing,
                collisions, and resizing.
            </p>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>Dictionary &amp; Sorted Timeline Evidence</h2>
            <p>
                Collection structures used to reduce lookup and timeline
                retrieval overhead.
            </p>
        </div>

        <div class="evidence-grid">
            <article class="evidence-card">
                <span class="evidence-icon">01</span>
                <h3>Dictionary-Based Device Index</h3>
                <p>
                    Maps device identifiers to their command records,
                    enabling direct key-based lookup instead of scanning
                    the entire history.
                </p>
                <code>Dictionary&lt;string, ...&gt;</code>
            </article>

            <article class="evidence-card">
                <span class="evidence-icon">02</span>
                <h3>Cached Device Results</h3>
                <p>
                    Maintains device-specific command snapshots and updates
                    them when commands are added, reducing repeated lookup
                    and projection work.
                </p>
                <code>GetCommandsForDevice()</code>
            </article>

            <article class="evidence-card">
                <span class="evidence-icon">03</span>
                <h3>Sorted Command Timeline</h3>
                <p>
                    Maintains chronological command ordering with a
                    deterministic identifier tie-breaker for records
                    with matching timestamps.
                </p>
                <code>SortedSet&lt;CommandRecord&gt;</code>
            </article>

            <article class="evidence-card">
                <span class="evidence-icon">04</span>
                <h3>Bounded Timeline Queries</h3>
                <p>
                    Supports date-range filtering, device filtering,
                    newest-first retrieval, and result limits through
                    the indexed timeline API.
                </p>
                <code>GetCommandTimeline()</code>
            </article>

            <article class="evidence-card">
                <span class="evidence-icon">05</span>
                <h3>Sorted Audit Events</h3>
                <p>
                    Maintains audit entries in chronological order using
                    timestamps and sequence numbers for deterministic ordering.
                </p>
                <code>SortedSet&lt;CommandAuditEntry&gt;</code>
            </article>

            <article class="evidence-card">
                <span class="evidence-icon">06</span>
                <h3>Workload Diagnostics</h3>
                <p>
                    Exercises repeated device lookups and timeline queries
                    over a larger collection to capture execution timings.
                </p>
                <code>Indexed lookup workload</code>
            </article>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>Core Collection Verification</h2>
            <p>Additional data structures supporting command processing.</p>
        </div>

        <ul class="evidence-list">
            <li>
                <strong>FIFO Queue</strong>
                <span>
                    Verifies submission order during standard command processing.
                </span>
            </li>
            <li>
                <strong>Priority Queue</strong>
                <span>
                    Verifies Critical, High, and Normal scheduling,
                    including ordering within equal priorities.
                </span>
            </li>
            <li>
                <strong>LIFO Stack</strong>
                <span>
                    Verifies undo behavior for the newest eligible pending command.
                </span>
            </li>
            <li>
                <strong>Audit Trail</strong>
                <span>
                    Verifies timestamped records for command submissions,
                    processing, undo, and error changes.
                </span>
            </li>
            <li>
                <strong>Concurrency &amp; Consistency</strong>
                <span>
                    Exercises repeated and concurrent operations while
                    checking collection consistency.
                </span>
            </li>
        </ul>
    </section>

    <p class="disclaimer">
        Execution times depend on the current runtime and workload. HashSet
        operations have expected average-case constant-time performance.
        These diagnostics provide test evidence, not a guarantee of constant-time
        performance. Records are maintained in application memory; command
        processing does not execute physical device operations.
    </p>
</div>

<style>
    .diagnostics-page {
        max-width: 1440px;
        margin: 0 auto;
        color: #19243a;
    }

    .page-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 24px;
    }

    .eyebrow {
        color: #3978ed;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    .page-heading h1 {
        margin: 9px 0 7px;
        font-size: clamp(25px, 3vw, 32px);
        font-weight: 800;
    }

    .page-heading p {
        max-width: 760px;
        margin: 0;
        color: #718096;
        font-size: 13px;
        line-height: 1.7;
    }

    .back-link {
        display: inline-block;
        padding: 10px 13px;
        border: 1px solid #dce4ef;
        border-radius: 7px;
        color: #35445d;
        background: white;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .back-link:hover {
            border-color: #a8c4ff;
            background: #f7f9ff;
        }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .summary-card,
    .panel {
        min-width: 0;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: white;
        box-shadow: 0 2px 7px rgb(16 28 53 / 3%);
    }

    .summary-card {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 19px 20px;
    }

        .summary-card span {
            color: #718096;
            font-size: 12px;
        }

        .summary-card strong {
            font-size: 27px;
            font-weight: 800;
        }

    .passed {
        color: #176b4a;
    }

    .failed {
        color: #b42318;
    }

    .panel {
        margin-bottom: 20px;
        overflow: hidden;
    }

    .panel-heading {
        padding: 19px 22px;
        border-bottom: 1px solid #edf0f5;
    }

        .panel-heading h2 {
            margin: 0 0 5px;
            font-size: 16px;
            font-weight: 800;
        }

        .panel-heading p {
            margin: 0;
            color: #718096;
            font-size: 12px;
            line-height: 1.6;
        }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 18px 22px;
    }

    .btn {
        min-height: 39px;
        padding: 10px 14px;
        border: 1px solid transparent;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 750;
        cursor: pointer;
    }

        .btn:disabled {
            cursor: not-allowed;
            opacity: .5;
        }

    .btn-primary {
        color: white;
        background: #285fca;
    }

        .btn-primary:hover:not(:disabled) {
            background: #1f4fae;
        }

    .btn-secondary {
        border-color: #dce4ef;
        color: #35445d;
        background: white;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    thead {
        background: #f8fafd;
    }

    th {
        padding: 12px 17px;
        color: #718096;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .4px;
        text-transform: uppercase;
    }

    td {
        padding: 15px 17px;
        border-top: 1px solid #edf0f5;
        color: #4c5b70;
        font-size: 12px;
        vertical-align: top;
    }

    tbody tr:hover {
        background: #fafcff;
    }

    .test-name {
        color: #243956;
        font-weight: 750;
        white-space: nowrap;
    }

    .details {
        min-width: 240px;
        line-height: 1.6;
    }

    .elapsed {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .result-badge {
        display: inline-block;
        padding: 5px 8px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 800;
    }

    .result-pass {
        color: #176b4a;
        background: #e5f7ed;
    }

    .result-fail {
        color: #b42318;
        background: #ffebe9;
    }

    .empty-state {
        padding: 36px 18px;
        text-align: center;
    }

        .empty-state strong {
            font-size: 13px;
        }

        .empty-state p {
            margin: 7px 0 0;
            color: #8290a4;
            font-size: 12px;
        }

    .result-summary {
        margin: 0 22px 22px;
        padding: 16px;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
    }

        .result-summary strong {
            font-size: 13px;
        }

        .result-summary p {
            margin: 6px 0 0;
            font-size: 12px;
            line-height: 1.6;
        }

    .summary-pass {
        border-color: #ccebd8;
        color: #176b4a;
        background: #f3fbf6;
    }

    .summary-fail {
        border-color: #f3ceca;
        color: #b42318;
        background: #fff5f4;
    }

    .evidence-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        padding: 18px 22px;
    }

    .evidence-card {
        min-width: 0;
        padding: 17px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #fbfcfe;
    }

    .evidence-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 29px;
        height: 29px;
        margin-bottom: 11px;
        border-radius: 6px;
        color: #285fca;
        background: #eaf1ff;
        font-size: 10px;
        font-weight: 800;
    }

    .evidence-card h3 {
        margin: 0 0 8px;
        color: #243956;
        font-size: 13px;
        font-weight: 800;
    }

    .evidence-card p {
        margin: 0 0 12px;
        color: #718096;
        font-size: 12px;
        line-height: 1.7;
    }

    .evidence-card code {
        display: inline-block;
        max-width: 100%;
        padding: 6px 8px;
        border-radius: 4px;
        color: #35445d;
        background: #edf1f6;
        font-size: 11px;
        overflow-wrap: anywhere;
    }

    .set-complexity {
        margin: 0 22px 22px;
        padding: 18px;
        border: 1px solid #dce7fb;
        border-radius: 8px;
        background: #f7f9ff;
    }

        .set-complexity h3 {
            margin: 0 0 14px;
            color: #243956;
            font-size: 13px;
            font-weight: 800;
        }

    .complexity-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

        .complexity-grid div {
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding: 12px;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            background: white;
        }

        .complexity-grid strong {
            color: #285fca;
            font-size: 13px;
        }

        .complexity-grid span {
            color: #718096;
            font-size: 11px;
        }

    .set-complexity > p {
        margin: 13px 0 0;
        color: #718096;
        font-size: 11px;
        line-height: 1.6;
    }

    .evidence-list {
        display: grid;
        gap: 0;
        margin: 0;
        padding: 0;
        list-style: none;
    }

        .evidence-list li {
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding: 16px 22px;
            border-bottom: 1px solid #edf0f5;
        }

            .evidence-list li:last-child {
                border-bottom: 0;
            }

        .evidence-list strong {
            color: #243956;
            font-size: 12px;
        }

        .evidence-list span {
            color: #718096;
            font-size: 12px;
            line-height: 1.6;
        }

    .disclaimer {
        margin: 0 0 8px;
        color: #7c899b;
        font-size: 11px;
        line-height: 1.7;
    }

    @@media (max-width: 850px) {
        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .evidence-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .page-heading {
            flex-direction: column;
        }

        .summary-grid {
            gap: 10px;
        }

        .summary-card {
            padding: 15px;
        }

        .panel-heading {
            padding: 16px;
        }

        .actions {
            padding: 16px;
        }

        .evidence-grid {
            padding: 16px;
        }

        .result-summary,
        .set-complexity {
            margin-right: 16px;
            margin-left: 16px;
        }

        .complexity-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private IReadOnlyList<DiagnosticResult> _results =
        Array.Empty<DiagnosticResult>();

    private bool _hasRun;

    private bool _allPassed =>
        _results.Count > 0 &&
        _results.All(result => result.Passed);

    private void RunDiagnostics()
    {
        try
        {
            _results = CommandCollectionDiagnostics.RunAll();
        }
        catch (Exception ex)
        {
            _results = new[]
            {
                new DiagnosticResult(
                    "Diagnostic execution",
                    false,
                    $"{ex.GetType().Name}: {ex.Message}",
                    0)
            };
        }

        _hasRun = true;
    }

    private void ClearResults()
    {
        _results = Array.Empty<DiagnosticResult>();
        _hasRun = false;
    }
}
