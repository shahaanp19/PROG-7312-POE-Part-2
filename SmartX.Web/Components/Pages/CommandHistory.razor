@page "/command-history"
@using System.Globalization
@using SmartX.Web.Services
@inject CommandStateService CommandState

<PageTitle>Command History - Smart-X</PageTitle>

<div class="history-page">
    <header class="page-header">
        <div>
            <h1>Command History</h1>
            <p>Search and review submitted device commands.</p>
        </div>

        <button class="button button-primary" @onclick="RefreshHistory">
            Refresh
        </button>
    </header>

    <section class="summary-grid">
        <div class="summary-card">
            <span>Matching commands</span>
            <strong>@MatchingHistoryCount</strong>
        </div>

        <div class="summary-card">
            <span>Processed commands</span>
            <strong>@ProcessedCount</strong>
        </div>

        <div class="summary-card">
            <span>Pending commands</span>
            <strong>@CommandState.QueueCount</strong>
        </div>
    </section>

    <section class="panel">
        <h2>Filter history</h2>

        <div class="filter-grid">
            <div class="filter-field">
                <label for="search">Search</label>
                <input id="search"
                       type="search"
                       placeholder="Command, device ID, or command ID"
                       @bind="_searchText"
                       @bind:event="oninput" />
            </div>

            <div class="filter-field">
                <label for="deviceFilter">Device ID</label>
                <input id="deviceFilter"
                       type="text"
                       placeholder="Filter by device"
                       @bind="_deviceFilter"
                       @bind:event="oninput" />
            </div>

            <div class="filter-field">
                <label for="statusFilter">Status</label>
                <select id="statusFilter" @bind="_statusFilter">
                    <option value="All">All statuses</option>
                    <option value="Queued">Queued</option>
                    <option value="Processed locally">Processed locally</option>
                    <option value="Undone">Undone</option>
                    <option value="Cleared">Cleared</option>
                </select>
            </div>

            <div class="filter-field">
                <label for="fromDate">From date</label>
                <input id="fromDate"
                       type="date"
                       value="@_fromDate"
                       @onchange="OnFromDateChanged" />
            </div>

            <div class="filter-field">
                <label for="toDate">To date</label>
                <input id="toDate"
                       type="date"
                       value="@_toDate"
                       @onchange="OnToDateChanged" />
            </div>
        </div>

        <div class="filter-actions">
            <button class="button button-primary" @onclick="ApplyFilters">
                Apply filters
            </button>

            <button class="button button-secondary" @onclick="ClearFilters">
                Clear filters
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_validationMessage))
        {
            <p class="validation-message">@_validationMessage</p>
        }
    </section>

    <section class="panel">
        <div class="section-heading">
            <div>
                <h2>Command timeline</h2>
                <p>Newest commands appear first. Up to @DisplayLimit results are shown.</p>
            </div>

            <span class="result-count">@FilteredHistory.Count() results shown</span>
        </div>

        @if (FilteredHistory.Count == 0)
        {
            <div class="empty-state">
                <h3>No commands found</h3>
                <p>Change your filters or clear them to see more commands.</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Created</th>
                            <th>Device ID</th>
                            <th>Command</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Command ID</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var record in FilteredHistory)
                        {
                            <tr @key="record.Id">
                                <td>@FormatTimestamp(record.CreatedAt)</td>
                                <td>@record.DeviceId</td>
                                <td>
                                    <strong>@record.Command</strong>

                                    @if (!string.IsNullOrWhiteSpace(record.Parameters))
                                    {
                                        <div class="secondary-text">
                                            @record.Parameters
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(record.Details))
                                    {
                                        <div class="secondary-text">
                                            @record.Details
                                        </div>
                                    }
                                </td>
                                <td>@record.Priority</td>
                                <td>
                                    <span class="@GetStatusClass(record.Status)">
                                        @record.Status
                                    </span>
                                </td>
                                <td class="command-id">@record.Id</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<style>
    .history-page {
        max-width: 1450px;
        margin: 0 auto;
        padding: 24px;
        color: var(--mud-palette-text-primary, #202938);
    }

    .page-header,
    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

        .page-header h1 {
            margin: 0 0 8px;
            font-size: 2rem;
            font-weight: 700;
        }

        .page-header p,
        .section-heading p {
            margin: 0;
            color: var(--mud-palette-text-secondary, #667085);
        }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .summary-card,
    .panel {
        padding: 20px;
        border: 1px solid var(--mud-palette-lines-default, #e5e7eb);
        border-radius: 12px;
        background: var(--mud-palette-surface, #ffffff);
    }

    .summary-card {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .summary-card span {
            color: var(--mud-palette-text-secondary, #667085);
            font-size: 0.9rem;
        }

        .summary-card strong {
            font-size: 1.8rem;
        }

    .panel {
        margin-bottom: 24px;
    }

        .panel h2 {
            margin: 0 0 18px;
            font-size: 1.2rem;
        }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .filter-field {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 8px;
    }

        .filter-field label {
            font-size: 0.9rem;
            font-weight: 600;
        }

        .filter-field input,
        .filter-field select {
            box-sizing: border-box;
            width: 100%;
            min-width: 0;
            padding: 10px 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            background: var(--mud-palette-surface, #ffffff);
            color: inherit;
        }

    .filter-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }

    .button {
        padding: 10px 16px;
        border: 0;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

    .button-primary {
        background: #2563eb;
        color: #ffffff;
    }

    .button-secondary {
        background: #e5e7eb;
        color: #1f2937;
    }

    .validation-message {
        margin: 14px 0 0;
        color: #b91c1c;
    }

    .section-heading {
        margin-bottom: 18px;
    }

        .section-heading h2 {
            margin-bottom: 6px;
        }

    .result-count {
        padding: 6px 10px;
        border-radius: 20px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 0.85rem;
        white-space: nowrap;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    th,
    td {
        padding: 13px 12px;
        border-bottom: 1px solid #e5e7eb;
        vertical-align: top;
    }

    th {
        color: var(--mud-palette-text-secondary, #667085);
        font-size: 0.82rem;
        font-weight: 700;
        white-space: nowrap;
    }

    td {
        font-size: 0.9rem;
    }

    .secondary-text {
        margin-top: 5px;
        color: var(--mud-palette-text-secondary, #667085);
        font-size: 0.8rem;
        overflow-wrap: anywhere;
    }

    .command-id {
        min-width: 180px;
        overflow-wrap: anywhere;
        font-family: monospace;
        font-size: 0.8rem;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 9px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-queued {
        background: #fef3c7;
        color: #92400e;
    }

    .status-processed {
        background: #dcfce7;
        color: #166534;
    }

    .status-undone,
    .status-cleared {
        background: #e5e7eb;
        color: #374151;
    }

    .status-default {
        background: #f3f4f6;
        color: #374151;
    }

    .empty-state {
        padding: 40px 20px;
        text-align: center;
    }

        .empty-state h3 {
            margin: 0 0 8px;
        }

        .empty-state p {
            margin: 0;
            color: var(--mud-palette-text-secondary, #667085);
        }

    @@media (max-width: 850px) {
        .filter-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 560px) {
        .history-page {
            padding: 14px;
        }

        .page-header,
        .section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .filter-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private const int DisplayLimit = 100;

    private string _searchText = string.Empty;
    private string _deviceFilter = string.Empty;
    private string _statusFilter = "All";
    private string? _fromDate;
    private string? _toDate;
    private string? _validationMessage;

    private List<CommandRecord> FilteredHistory =>
        GetFilteredHistory();

    private int MatchingHistoryCount =>
        GetAllFilteredHistory().Count;

    private int ProcessedCount =>
        CommandState.History.Count(record =>
            string.Equals(
                record.Status,
                "Processed locally",
                StringComparison.OrdinalIgnoreCase));

    private void OnFromDateChanged(ChangeEventArgs e)
    {
        _fromDate = e.Value?.ToString();
        _validationMessage = null;
    }

    private void OnToDateChanged(ChangeEventArgs e)
    {
        _toDate = e.Value?.ToString();
        _validationMessage = null;
    }

    private void ApplyFilters()
    {
        _validationMessage = null;

        if (!TryGetDateRange(out _, out _))
        {
            _validationMessage =
                "Enter valid dates and ensure the From date is not after the To date.";
        }
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _deviceFilter = string.Empty;
        _statusFilter = "All";
        _fromDate = null;
        _toDate = null;
        _validationMessage = null;
    }

    private void RefreshHistory()
    {
        StateHasChanged();
    }

    private bool TryGetDateRange(
        out DateTimeOffset? from,
        out DateTimeOffset? toExclusive)
    {
        from = null;
        toExclusive = null;

        DateOnly? fromDate = null;
        DateOnly? toDate = null;

        if (!string.IsNullOrWhiteSpace(_fromDate))
        {
            if (!DateOnly.TryParseExact(
                    _fromDate,
                    "yyyy-MM-dd",
                    CultureInfo.InvariantCulture,
                    DateTimeStyles.None,
                    out var parsedFrom))
            {
                return false;
            }

            fromDate = parsedFrom;
        }

        if (!string.IsNullOrWhiteSpace(_toDate))
        {
            if (!DateOnly.TryParseExact(
                    _toDate,
                    "yyyy-MM-dd",
                    CultureInfo.InvariantCulture,
                    DateTimeStyles.None,
                    out var parsedTo))
            {
                return false;
            }

            toDate = parsedTo;
        }

        if (fromDate.HasValue &&
            toDate.HasValue &&
            fromDate.Value > toDate.Value)
        {
            return false;
        }

        if (fromDate.HasValue)
        {
            var localStart = fromDate.Value.ToDateTime(TimeOnly.MinValue);
            from = new DateTimeOffset(
                localStart,
                TimeZoneInfo.Local.GetUtcOffset(localStart));
        }

        if (toDate.HasValue)
        {
            var localEnd = toDate.Value
                .AddDays(1)
                .ToDateTime(TimeOnly.MinValue);

            toExclusive = new DateTimeOffset(
                localEnd,
                TimeZoneInfo.Local.GetUtcOffset(localEnd));
        }

        return true;
    }

    private List<CommandRecord> GetFilteredHistory()
    {
        if (!TryGetDateRange(out _, out _))
            return new List<CommandRecord>();

        return GetAllFilteredHistory()
            .Take(DisplayLimit)
            .ToList();
    }

    private List<CommandRecord> GetAllFilteredHistory()
    {
        if (!TryGetDateRange(out var from, out var toExclusive))
            return new List<CommandRecord>();

        IEnumerable<CommandRecord> records =
            CommandState.GetCommandTimeline(
                from: from,
                to: toExclusive);

        if (!string.IsNullOrWhiteSpace(_deviceFilter))
        {
            var device = _deviceFilter.Trim();

            records = records.Where(record =>
                record.DeviceId.Contains(
                    device,
                    StringComparison.OrdinalIgnoreCase));
        }

        if (!string.Equals(
                _statusFilter,
                "All",
                StringComparison.OrdinalIgnoreCase))
        {
            records = records.Where(record =>
                string.Equals(
                    record.Status,
                    _statusFilter,
                    StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var search = _searchText.Trim();

            records = records.Where(record =>
                record.DeviceId.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                || record.Command.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                || record.Id.ToString().Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                || record.Status.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                || record.Priority.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                || record.Parameters.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase));
        }

        return records.ToList();
    }

    private static string FormatTimestamp(DateTimeOffset timestamp)
    {
        return timestamp.ToLocalTime().ToString(
            "yyyy-MM-dd HH:mm:ss",
            CultureInfo.CurrentCulture);
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Queued" => "status-badge status-queued",
            "Processed locally" => "status-badge status-processed",
            "Undone" => "status-badge status-undone",
            "Cleared" => "status-badge status-cleared",
            _ => "status-badge status-default"
        };
    }
}
