@page "/sensor-dashboard"
@using System.Net.Http.Json
@using System.Text.Json
@using SmartX.Web.Services
@implements IAsyncDisposable
@inject IHttpClientFactory HttpClientFactory
@inject RecommendationEngine RecommendationEngine
@inject ILogger<Home> Logger

<PageTitle>Smart-X Predictive Dashboard</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Smart-X Predictive Dashboard</h1>
            <p class="text-muted mb-0">Real-time telemetry and predictive insights</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge @GatewayBadgeClass">@GatewayStatus</span>
            <span class="badge @RefreshBadgeClass">@RefreshStatus</span>
            <button class="btn btn-primary"
                    @onclick="RefreshNowAsync"
                    disabled="@IsRefreshing">
                @(IsRefreshing ? "Refreshing..." : "Refresh now")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(PageError))
    {
        <div class="alert alert-warning" role="alert">
            <strong>Dashboard update issue:</strong> @PageError
            @if (LastSuccessfulRefresh.HasValue)
            {
                <div class="small mt-1">
                    Last successful refresh:
                    @LastSuccessfulRefresh.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                </div>
            }
            <button class="btn btn-sm btn-outline-dark mt-2"
                    @onclick="RefreshNowAsync"
                    disabled="@IsRefreshing">
                Retry
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(RecommendationMessage))
    {
        <div class="alert alert-info" role="status">@RecommendationMessage</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Telemetry readings</div>
                    <div class="display-6">@TelemetryReadings.Count</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Devices reporting</div>
                    <div class="display-6">@DeviceCount</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Critical recommendations</div>
                    <div class="display-6 text-danger">@CriticalCount</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Total recommendations</div>
                    <div class="display-6">@Recommendations.Count</div>
                </div>
            </div>
        </div>
    </div>

    <section class="card shadow-sm mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h5 mb-0">Predictive recommendations</h2>
            <span class="small text-muted">
                Updated @(LastSuccessfulRefresh?.ToLocalTime().ToString("HH:mm:ss") ?? "Not yet")
            </span>
        </div>

        <div class="card-body">
            @if (IsInitialLoad)
            {
                <div class="py-3">
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    Loading telemetry and generating recommendations...
                </div>
            }
            else if (Recommendations.Count == 0)
            {
                <p class="text-muted mb-0">
                    No actionable recommendations were detected in the available telemetry and operational state.
                </p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var recommendation in Recommendations)
                    {
                        <div class="col-12 col-lg-6"
                             @key="RecommendationKey(recommendation)">
                            <article class="card h-100 border-start border-4 @SeverityBorder(recommendation.Severity)">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <h3 class="h6 mb-0">@recommendation.Title</h3>
                                        <span class="badge @SeverityBadge(recommendation.Severity)">
                                            @recommendation.Severity
                                        </span>
                                    </div>

                                    <p class="mb-2">@recommendation.Description</p>

                                    @if (recommendation.DeviceId.HasValue &&
                                         recommendation.DeviceId.Value != Guid.Empty)
                                    {
                                        <div class="small text-muted">
                                            Device: @recommendation.DeviceId.Value
                                        </div>
                                    }
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Recent telemetry</h2>
            <span class="badge text-bg-secondary">@TelemetryReadings.Count readings</span>
        </div>

        <div class="card-body p-0">
            @if (TelemetryReadings.Count == 0)
            {
                <p class="text-muted p-3 mb-0">No telemetry readings available.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Device</th>
                                <th>Metric</th>
                                <th>Value</th>
                                <th>Warning</th>
                                <th>Critical</th>
                                <th>Observed</th>
                                <th>Freshness</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reading in TelemetryReadings.Take(100))
                            {
                                <tr @key="TelemetryKey(reading)">
                                    <td>@reading.SensorId.ToString("N")[..8]</td>
                                    <td>@reading.MetricName</td>
                                    <td>@reading.Value.ToString("0.##") @reading.Unit</td>
                                    <td>@FormatThreshold(reading.WarningThreshold)</td>
                                    <td>@FormatThreshold(reading.CriticalThreshold)</td>
                                    <td class="text-nowrap">
                                        @reading.ObservedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                    </td>
                                    <td>
                                        <span class="badge @FreshnessBadge(reading.ObservedAt)">
                                            @FreshnessText(reading.ObservedAt)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <div class="d-flex flex-wrap justify-content-between gap-2 small text-muted">
        <span>Automatic refresh: every @((int)RefreshInterval.TotalSeconds) seconds</span>
        <span>Last attempt: @(LastRefreshAttempt?.ToLocalTime().ToString("HH:mm:ss") ?? "Not yet")</span>
    </div>
</div>

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(10);
    private static readonly TimeSpan StaleThreshold = TimeSpan.FromMinutes(15);

    private readonly CancellationTokenSource _disposeCts = new();
    private readonly SemaphoreSlim _refreshLock = new(1, 1);

    private PeriodicTimer? _timer;
    private Task? _refreshLoop;
    private bool _disposed;

    private List<TelemetryHistoryDto> TelemetryReadings { get; set; } = new();
    private List<SmartXRecommendation> Recommendations { get; set; } = new();

    private bool IsInitialLoad { get; set; } = true;
    private bool IsRefreshing { get; set; }

    private string GatewayStatus { get; set; } = "Checking";
    private string RefreshStatus { get; set; } = "Starting";
    private string? PageError { get; set; }
    private string? RecommendationMessage { get; set; }

    private DateTimeOffset? LastSuccessfulRefresh { get; set; }
    private DateTimeOffset? LastRefreshAttempt { get; set; }

    private int DeviceCount => TelemetryReadings
        .Where(x => x.SensorId != Guid.Empty)
        .Select(x => x.SensorId)
        .Distinct()
        .Count();

    private int CriticalCount => Recommendations.Count(
        x => x.Severity == RecommendationSeverity.Critical);

    private string GatewayBadgeClass => GatewayStatus switch
    {
        "Online" => "text-bg-success",
        "Offline" => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    private string RefreshBadgeClass => RefreshStatus switch
    {
        "Live" => "text-bg-success",
        "Degraded" => "text-bg-warning",
        _ => "text-bg-secondary"
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshNowAsync();

        if (!_disposed)
        {
            _timer = new PeriodicTimer(RefreshInterval);
            _refreshLoop = RunRefreshLoopAsync(_disposeCts.Token);
        }
    }

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (_timer is not null &&
                   await _timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(RefreshNowAsync);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Expected during disposal.
        }
        catch (ObjectDisposedException)
        {
            // Expected when the timer is disposed.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Dashboard refresh loop failed.");

            if (!_disposed)
            {
                await InvokeAsync(() =>
                {
                    RefreshStatus = "Degraded";
                    PageError = "Automatic refresh stopped unexpectedly. Use Refresh now to retry.";
                    StateHasChanged();
                });
            }
        }
    }

    private async Task RefreshNowAsync()
    {
        if (_disposed || !await _refreshLock.WaitAsync(0))
            return;

        IsRefreshing = true;
        LastRefreshAttempt = DateTimeOffset.UtcNow;

        try
        {
            var client = HttpClientFactory.CreateClient("SmartX.Api");

            await CheckGatewayAsync(client, _disposeCts.Token);

            using var response = await client.GetAsync(
                "api/telemetry-history/recent?countPerSensor=100",
                _disposeCts.Token);

            response.EnsureSuccessStatusCode();

            var result = await response.Content
                .ReadFromJsonAsync<List<TelemetryHistoryDto>>(
                    cancellationToken: _disposeCts.Token);

            if (result is null)
                throw new JsonException("The telemetry API returned an empty response.");

            var validReadings = result
                .Where(IsValidReading)
                .OrderByDescending(x => x.ObservedAt)
                .ToList();

            var observations = validReadings
                .Select(x => new TelemetryObservation
                {
                    DeviceId = x.SensorId,
                    Metric = x.MetricName.Trim(),
                    Value = x.Value,
                    Unit = x.Unit ?? string.Empty,
                    ObservedAt = x.ObservedAt,
                    WarningThreshold = x.WarningThreshold,
                    CriticalThreshold = x.CriticalThreshold
                })
                .ToList();

            try
            {
                Recommendations = RecommendationEngine.Generate(observations).ToList();
                RecommendationMessage = null;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Recommendation generation failed.");
                RecommendationMessage =
                    "Telemetry refreshed, but recommendation generation failed. Previous recommendations have been retained.";
            }

            TelemetryReadings = validReadings;
            LastSuccessfulRefresh = DateTimeOffset.UtcNow;
            PageError = null;
            RefreshStatus = "Live";

            if (validReadings.Count == 0)
            {
                RecommendationMessage ??=
                    "No valid telemetry readings were returned by the API.";
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
            // Expected during disposal.
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Telemetry API request failed.");
            PageError =
                "Unable to retrieve telemetry. Check the API availability and the configured HTTP client.";
            RefreshStatus = "Degraded";
        }
        catch (JsonException ex)
        {
            Logger.LogWarning(ex, "Telemetry response parsing failed.");
            PageError = "The telemetry API returned data in an unexpected format.";
            RefreshStatus = "Degraded";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected dashboard refresh failure.");
            PageError =
                "An unexpected error occurred. Previously loaded telemetry and recommendations have been retained.";
            RefreshStatus = "Degraded";
        }
        finally
        {
            IsRefreshing = false;
            IsInitialLoad = false;
            _refreshLock.Release();

            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CheckGatewayAsync(
        HttpClient client,
        CancellationToken cancellationToken)
    {
        try
        {
            using var response = await client.GetAsync(
                "api/telemetry/health",
                cancellationToken);

            GatewayStatus = response.IsSuccessStatusCode ? "Online" : "Offline";
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Gateway health check failed.");
            GatewayStatus = "Offline";
        }
    }

    private static bool IsValidReading(TelemetryHistoryDto reading)
    {
        return reading.SensorId != Guid.Empty
            && !string.IsNullOrWhiteSpace(reading.MetricName)
            && double.IsFinite(reading.Value)
            && double.IsFinite(reading.WarningThreshold)
            && double.IsFinite(reading.CriticalThreshold)
            && reading.ObservedAt != default
            && reading.ObservedAt <= DateTimeOffset.UtcNow.AddMinutes(5);
    }

    private static string SeverityBadge(RecommendationSeverity severity) =>
        severity switch
        {
            RecommendationSeverity.Critical => "text-bg-danger",
            RecommendationSeverity.Warning => "text-bg-warning",
            _ => "text-bg-info"
        };

    private static string SeverityBorder(RecommendationSeverity severity) =>
        severity switch
        {
            RecommendationSeverity.Critical => "border-danger",
            RecommendationSeverity.Warning => "border-warning",
            _ => "border-info"
        };

    private static string RecommendationKey(SmartXRecommendation recommendation) =>
        $"{recommendation.Severity}|{recommendation.DeviceId}|{recommendation.Title}|{recommendation.Description}";

    private static string TelemetryKey(TelemetryHistoryDto reading) =>
        $"{reading.SensorId:N}|{reading.MetricName}|{reading.ObservedAt.UtcDateTime.Ticks}";

    private static string FormatThreshold(double value) =>
        value == 0 ? "—" : value.ToString("0.##");

    private static string FreshnessText(DateTimeOffset observedAt)
    {
        var age = DateTimeOffset.UtcNow - observedAt.ToUniversalTime();

        if (age < TimeSpan.FromMinutes(1))
            return "Recent";

        if (age > StaleThreshold)
            return "Stale";

        return $"{(int)age.TotalMinutes} min ago";
    }

    private static string FreshnessBadge(DateTimeOffset observedAt)
    {
        var age = DateTimeOffset.UtcNow - observedAt.ToUniversalTime();

        if (age < TimeSpan.FromMinutes(1))
            return "text-bg-success";

        return age > StaleThreshold
            ? "text-bg-warning"
            : "text-bg-secondary";
    }

    private sealed class TelemetryHistoryDto
    {
        public Guid SensorId { get; set; }
        public double Value { get; set; }
        public DateTimeOffset ObservedAt { get; set; }
        public string MetricName { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public double WarningThreshold { get; set; }
        public double CriticalThreshold { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;

        await _disposeCts.CancelAsync();
        _timer?.Dispose();

        if (_refreshLoop is not null)
        {
            try
            {
                await _refreshLoop;
            }
            catch (OperationCanceledException)
            {
                // Expected during disposal.
            }
        }

        _refreshLock.Dispose();
        _disposeCts.Dispose();
    }
}